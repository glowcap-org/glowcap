module minimal

interface Reader {
  read() -> string
}

interface Source {
  open() -> Reader
  accept(reader: Reader) -> undefined
  acceptPending(reader: promise<Reader>) -> undefined
  optional(value?: string) -> undefined
  value() -> value
}

interface Notices {
  tell zero()
  tell text(value: string)
  tell absent(value: undefined)
  tell changed(value: value)
  tell optional(value?: undefined)
}

interface Prepared {
  @loam.receipt
  accept(pending: promise<value>) -> undefined
  @loam.receipt
  capture(name: string(min_bytes: 1, max_bytes: 64), reader: Reader, pending?: promise<Reader>) -> tuple<Reader, bool>
  @loam.receipt
  optional(name?: string, bytes?: bytes, marker?: symbol) -> bool
  @loam.receipt
  scalars(integer: integer(min: 0, max: 64), flag: bool, marker: symbol, error: error) -> bool
  @loam.receipt
  data(bytes: bytes, float: float64, absent: undefined) -> bool
}

type Name = string(min_bytes: 1, max_bytes: 64)
type LowerText = string(min_bytes: 1)
type WideText = string(max_bytes: 9223372036854775807)
type Index = integer(min: 0, max: 9223372036854775807)
type Signed = integer(min: -9223372036854775808, max: 9223372036854775807)

interface Bounded {
  text(value: Name) -> Name
  lower(value: LowerText) -> undefined
  wide(value: WideText) -> WideText
  integer(value: Index) -> undefined
  tell index(value: Index)
  signed() -> Signed
  optional(value?: Name) -> Name
}
