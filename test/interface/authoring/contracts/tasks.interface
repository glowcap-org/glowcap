module tasks

type Name = string(min_bytes: 1, max_bytes: 64)
type Text = string(min_bytes: 1, max_bytes: 4096)
type Index = integer(min: 0, max: 9223372036854775807)
type ListCount = integer(min: 0, max: 16)
type TaskCount = integer(min: 0, max: 256)

interface Board {
  lists() -> ListCount
  list(index: Index) -> TaskList
  @loam.receipt "add-list"(name: Name) -> TaskList
}
interface TaskList {
  name() -> Name
  count() -> TaskCount
  task(index: Index) -> Task
  @loam.receipt add(text: Text) -> Task
  @loam.receipt move(task: Task, destination: TaskList) -> TaskCount
}
interface Task {
  text() -> Text
}
