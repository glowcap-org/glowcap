module shared.control
import "../board.interface" as tasks

type Name = string(min_bytes: 1, max_bytes: 64)
type Index = integer(min: 0, max: 16)
type Board = tasks.Board
interface Reader {
  read() -> Name
}

type Cursor = bytes(min_bytes: 56, max_bytes: 56)
type Observation = record<
  "access:observation", Cursor, value, bool, bool, list<symbol>
>
type Registration = tuple<Receiver, Canceller>
type Notices = list<symbol>(max_items: 16)
type Nested = tagged<"fixture/nested", tuple<Index, Name>>
type Empty = record<"fixture/empty">
interface Receiver {
  poll(cursor?: Cursor) -> Observation
  receive(cursor?: Cursor) -> Observation
}
interface Canceller {
  cancel() -> bool
}
interface Containers {
  notices() -> Notices
  nested() -> Nested
  empty_record() -> Empty
  empty_tuple() -> tuple<>
  positional() -> record<"fixture/nested", Index, Name>
}
