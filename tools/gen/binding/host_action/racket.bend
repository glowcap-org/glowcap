import Base
import ./render.bend as R
import ./schema.bend as S

def read(f: S.Field) -> String:
  match f:
    case S.Ticket{}:
      " (GlowcapHostAction-ticket a)"
    case S.RouteIndex{}:
      " (GlowcapHostAction-route-index a)"
    case S.Session{}:
      " (GlowcapHostAction-session a)"
    case S.Value{}:
      " (arg<-c (GlowcapHostAction-value a))"
    case S.ResultCode{}:
      " (GlowcapHostAction-result a)"
    case S.Cause{}:
      " (break-cause-fields<-c (GlowcapHostAction-cause a))"
    case S.Message{}:
      "\n           (view->string (GlowcapHostAction-message a) (GlowcapHostAction-message-len a))"

def note(f: S.Field) -> String:
  match f:
    case S.Value{}:
      "     ;; `arg<-c` copies every byte payload into fresh Racket values, so the\n     ;; outcome outlives the popped action's until-next-pop lifetime.\n"
    case _:
      ""

def kind(a: S.Arm) -> String:
  "HOST-ACTION-" ++ String.join(String.split(S.name(a), '_'), "-")

def exported(a: S.Arm) -> String:
  "         " ++ kind(a) ++ "\n"

def constant(a: S.Arm) -> String:
  +a = a
  "(define " ++ kind(a) ++ " " ++ S.tag(a) ++ ")\n"

def decode(a: S.Arm) -> String:
  +a = a
  "    [(= kind " ++ kind(a) ++ ")\n" ++ R.each(~S.Field, ~note, S.fields(a))
    ++ "     (list '" ++ S.dash(a) ++ R.each(~S.Field, ~read, S.fields(a)) ++ ")]\n"

def source(+arms: List<&2, S.Arm>) -> String:
  String.concat([
    "#lang racket/base
;; GENERATED by `zig build gen-binding-host-action` from src/c_abi/host
;; — do not edit.
;; `zig build gen-binding-host-action-check` (part of `check`) fails when
;; this is stale.
;;
;; Kind constants + decode for the Racket binding. Executor arms stay
;; in `action.rkt`. Does not require `abi-value.rkt` (that would cycle
;; through `constants.rkt`); the caller passes `arg<-c`.

(require ffi/unsafe
         \"constants.rkt\"
         \"ffi-shared.rkt\"
         \"ffi-host.rkt\"
         \"errors.rkt\")

",
    "(provide" ++ R.each(~S.Arm, ~exported, arms),
    "         host-decode-action!
         host-dispatch-action!)

;; GlowcapHostAction.kind — mirrors GLOWCAP_HOST_ACTION_* in glowcap_host.h.
",
    R.each(~S.Arm, ~constant, arms),
    "
;; Decode a filled GlowcapHostAction cstruct into the list form the
;; drain switch matches: `(list 'dial …)`, `(list 'flush …)`, …
;; `arg<-c` is passed by the caller (from `abi-value.rkt`) so this module
;; stays require-acyclic with constants.rkt.
(define (host-decode-action! a arg<-c)
  (define kind (GlowcapHostAction-kind a))
  (define (view->string ptr len) (bytes->string/utf-8 (bytes<-c ptr len) #\\uFFFD))
  (cond
",
    R.each(~S.Arm, ~decode, arms),
    "    [else (raise-glowcap 'glowcap ERR-INTERNAL
                         \"ABI returned unknown host action kind: ~a\" kind)]))

;; Exhaustive dispatch over a decoded action list. `handlers` is a
;; hash of racket symbols (`'dial`, `'flush`, …) to thunks of
;; `(lambda (a) …)`. A missing arm fails loud — the inventory lives
;; here so `action.rkt` cannot silently drop a new kind.
(define (host-dispatch-action! a handlers)
  (define tag (car a))
  (define fn (hash-ref handlers tag #f))
  (unless fn
    (error 'glowcap \"host-dispatch-action!: missing handler for ~a\" tag))
  (fn a))
"
  ])

def main() -> IO(Unit):
  IO.write(source(S.arms()))
