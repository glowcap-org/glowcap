import Base
import ./render.bend as R
import ./schema.bend as S

type Spelling is Data:
  Spelling{name: String, type_name: String, note: List<&2, String>, read: String}

def spelling(f: S.Field) -> Spelling:
  match f:
    case S.Ticket{}:
      Spelling{"ticket", "u64", [], "raw.ticket"}
    case S.RouteIndex{}:
      Spelling{"route_index", "usize", [], "raw.route_index"}
    case S.Session{}:
      Spelling{"session", "usize", [], "raw.session as usize"}
    case S.Value{}:
      Spelling{"value", "Argument",
        ["// SAFETY: `raw.value` is the settle value the host wrote into this `GlowcapHostAction`, whose",
         "// spines and leaves stay host-owned until the next pop; `arg_from_sys` copies them first."],
        "unsafe { arg_from_sys(&raw.value) }?"}
    case S.ResultCode{}:
      Spelling{"result", "i32", [], "raw.result"}
    case S.Cause{}:
      Spelling{"cause", "crate::sys::GlowcapBreakCause", [], "raw.cause"}
    case S.Message{}:
      Spelling{"message", "String", [], "view(raw.message, raw.message_len)"}

def spelled(fs: List<&2, S.Field>) -> List<&2, Spelling>:
  R.map(~S.Field, ~Spelling, ~spelling, fs)

def name(s: Spelling) -> String:
  Spelling{n, _, _, _} = s
  n

def param(s: Spelling) -> String:
  Spelling{n, t, _, _} = s
  n ++ ": " ++ t

def init(s: Spelling) -> String:
  Spelling{n, _, _, r} = s
  n ++ ": " ++ r

def note_line(text: String) -> String:
  "\t\t\t" ++ text ++ "\n"

def init_line(s: Spelling) -> String:
  Spelling{n, _, note, r} = s
  R.each(~String, ~note_line, note) ++ "\t\t\t" ++ n ++ ": " ++ r ++ ",\n"

def member_line(s: Spelling) -> String:
  "\t\t" ++ param(s) ++ ",\n"

def handler_param(s: Spelling) -> String:
  ", " ++ param(s)

def const_line(a: S.Arm) -> String:
  +a = a
  "pub const HOST_ACTION_" ++ S.name(a) ++ ": c_uint = " ++ S.tag(a) ++ ";\n"

def variant_text(+variant: String, fs: List<&2, S.Field>) -> String:
  match fs:
    case Nil{}:
      "\t" ++ variant ++ ",\n"
    case _:
      "\t" ++ variant ++ " {\n" ++ R.each(~Spelling, ~member_line, spelled(fs)) ++ "\t},\n"

def variant_arm(a: S.Arm) -> String:
  +a = a
  variant_text(S.variant(a), S.fields(a))

def pattern(+variant: String, fs: List<&2, S.Field>) -> String:
  match fs:
    case Nil{}:
      "HostAction::" ++ variant
    case _:
      "HostAction::" ++ variant ++ " { " ++ R.joined(~Spelling, ~name, ", ", spelled(fs)) ++ " }"

def decode_body(+head: String, fs: List<&2, S.Field>) -> String:
  match fs:
    case Nil{}:
      head ++ ",\n"
    case S.Ticket{} <> Nil{}:
      head ++ " { " ++ init(spelling(S.Ticket{})) ++ " },\n"
    case _:
      head ++ " {\n" ++ R.each(~Spelling, ~init_line, spelled(fs)) ++ "\t\t},\n"

def decode_text(a: S.Arm) -> String:
  +a = a
  decode_body("\t\tHOST_ACTION_" ++ S.name(a) ++ " => HostAction::" ++ S.variant(a), S.fields(a))

def dispatch_text(a: S.Arm) -> String:
  +a = a
  +fs = S.fields(a)
  "        " ++ pattern(S.variant(a), fs) ++ " => handlers." ++ S.snake(a)
    ++ "(" ++ R.joined(~Spelling, ~name, ", ", spelled(fs)) ++ ").await,\n"

def handler_text(a: S.Arm) -> String:
  +a = a
  "    fn " ++ S.snake(a) ++ "(&self" ++ R.each(~Spelling, ~handler_param, spelled(S.fields(a)))
    ++ ") -> impl std::future::Future<Output = crate::Result<()>> + '_;\n"

def source(+arms: List<&2, S.Arm>) -> String:
  String.concat([
    "//! GENERATED by `zig build gen-binding-host-action` from src/c_abi/host
//! — do not edit.
//! `zig build gen-binding-host-action-check` (part of `check`) fails when
//! this is stale.
//!
//! Kind constants, `HostAction`, and decode for the Rust binding.
//! Executor arms stay in `action.rs`.

// The generator owns these bytes; a formatter version bump must not
// drift them out from under `gen-binding-host-action-check`.
#![cfg_attr(rustfmt, rustfmt::skip)]

use core::ffi::c_uint;

use crate::sys::host as ffi;
use crate::{arg_from_sys, Argument, Error, Result};

/// `GlowcapHostAction.kind` — mirrors `GLOWCAP_HOST_ACTION_*` in
/// `glowcap_host.h`.
",
    R.each(~S.Arm, ~const_line, arms),
    "
/// One popped embedder action, every borrowed view lifted to owned
/// Rust values (a SETTLE's `GlowcapArgument` included) before the next
/// `glowcap_host_next_action` call can free them.
pub enum HostAction {
",
    R.each(~S.Arm, ~variant_arm, arms),
    "}

/// Decode a filled `GlowcapHostAction` into an owned `HostAction`.
/// An unknown ABI discriminant is a returned internal failure, never a
/// process panic.
pub fn decode(raw: &ffi::GlowcapHostAction) -> Result<HostAction> {
	let view = |ptr: *const u8, len: usize| -> String {
		if ptr.is_null() || len == 0 {
			String::new()
		} else {
			// The bytes originate in a partner-authored give, so decode
			// leniently rather than let untrusted bytes fault mid-drain.
			// SAFETY: `ptr` is non-null (checked above) and names `len` bytes of a view the host owns in the
			// `GlowcapHostAction` being decoded, live until the next pop; `into_owned` copies them first.
			String::from_utf8_lossy(unsafe { core::slice::from_raw_parts(ptr, len) }).into_owned()
		}
	};
	Ok(match raw.kind {
",
    R.each(~S.Arm, ~decode_text, arms),
    "		kind => return Err(Error::with_detail(
			crate::sys::ERR_INTERNAL,
			format!(\"glowcap ABI returned unknown host action kind {kind}\"),
		)),
	})
}

/// Exhaustive dispatch over `HostAction`. Handlers expose one async fn
/// per arm; a new kind fails to compile here.
pub async fn dispatch<H>(action: HostAction, handlers: &H) -> crate::Result<()>
where
    H: HostActionHandlers,
{
    match action {
",
    R.each(~S.Arm, ~dispatch_text, arms),
    "    }
}

/// Per-arm I/O the binding supplies to [`dispatch`].
pub trait HostActionHandlers {
",
    R.each(~S.Arm, ~handler_text, arms),
    "}
"
  ])

def main() -> IO(Unit):
  IO.write(source(S.arms()))
