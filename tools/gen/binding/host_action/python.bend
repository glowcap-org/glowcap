import Base
import ./render.bend as R
import ./schema.bend as S

type Spelling is Data:
  Spelling{attr: String, annotation: String, decoded: String}

def spelling(f: S.Field) -> Spelling:
  match f:
    case S.Ticket{}:
      Spelling{"ticket", "int", "a.ticket"}
    case S.RouteIndex{}:
      Spelling{"route_index", "int", "a.route_index"}
    case S.Session{}:
      Spelling{"session_ptr", "int", "a.session or 0"}
    case S.Value{}:
      Spelling{"value", "object", "_arg_from_c(a.value)"}
    case S.ResultCode{}:
      Spelling{"result", "int", "a.result"}
    case S.Cause{}:
      Spelling{"cause", "tuple[int, int, int]", "(a.cause.origin, a.cause.reason, a.cause.context)"}
    case S.Message{}:
      Spelling{"message", "str", "_view(a.message, a.message_len)"}

def spelled(fs: List<&2, S.Field>) -> List<&2, Spelling>:
  R.map(~S.Field, ~Spelling, ~spelling, fs)

def declared(s: Spelling) -> String:
  Spelling{attr, annotation, _} = s
  "    " ++ attr ++ ": " ++ annotation ++ "\n"

def keyword(s: Spelling) -> String:
  Spelling{attr, _, decoded} = s
  attr ++ "=" ++ decoded

def body(ss: List<&2, Spelling>) -> String:
  match ss:
    case Nil{}:
      "    pass\n"
    case _:
      R.each(~Spelling, ~declared, ss)

def constant(a: S.Arm) -> String:
  +a = a
  "HOST_ACTION_" ++ S.name(a) ++ " = " ++ S.tag(a) ++ "\n"

def klass(a: S.Arm) -> String:
  +a = a
  "@dataclass(frozen=True)\nclass " ++ S.variant(a) ++ ":\n" ++ body(spelled(S.fields(a))) ++ "\n\n"

def decode(a: S.Arm) -> String:
  +a = a
  "    if kind == HOST_ACTION_" ++ S.name(a) ++ ":\n        return " ++ S.variant(a)
    ++ "(" ++ R.joined(~Spelling, ~keyword, ", ", spelled(S.fields(a))) ++ ")\n"

def dispatch(a: S.Arm) -> String:
  +a = a
  "        case " ++ S.variant(a) ++ "():\n            await handlers." ++ S.snake(a) ++ "(action)\n"

def source(+arms: List<&2, S.Arm>) -> String:
  String.concat([
    "# GENERATED by `zig build gen-binding-host-action` from src/c_abi/host
# — do not edit.
# `zig build gen-binding-host-action-check` (part of `check`) fails when
# this is stale.
#
# Kind constants, HostAction union, and decode for the Python binding.
# Executor arms stay in `_action.py`.

from __future__ import annotations

import ctypes
from dataclasses import dataclass
from typing import Union


# GlowcapHostAction.kind — mirrors GLOWCAP_HOST_ACTION_* in glowcap_host.h.
",
    R.each(~S.Arm, ~constant, arms),
    "

",
    R.each(~S.Arm, ~klass, arms),
    "HostAction = Union[" ++ R.joined(~S.Arm, ~S.variant, ", ", arms) ++ "]\n",
    "

def _view(ptr, length) -> str:
    # The bytes originate in a partner-authored give, so decode
    # leniently rather than let untrusted bytes raise mid-drain.
    return ctypes.string_at(ptr, length).decode(errors=\"replace\") if ptr and length else \"\"


def decode(a) -> HostAction:
    \"\"\"Decode a filled ``GlowcapHostAction`` ctypes struct into an
    owned ``HostAction`` variant. Lazily imports ``_arg_from_c`` so
    this module stays importable without a codec cycle.
    \"\"\"
    from ._abi_value import _arg_from_c

    kind = a.kind
",
    R.each(~S.Arm, ~decode, arms),
    "    raise RuntimeError(f\"unknown host action kind: {kind}\")


async def dispatch(action: HostAction, handlers) -> None:
    \"\"\"Await the handler method named for the action's variant.\"\"\"
    match action:
",
    R.each(~S.Arm, ~dispatch, arms),
    "        case _:
            raise RuntimeError(f\"unknown host action: {action!r}\")
"
  ])

def main() -> IO(Unit):
  IO.write(source(S.arms()))
