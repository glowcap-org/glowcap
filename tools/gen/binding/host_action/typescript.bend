import Base
import ./render.bend as R
import ./schema.bend as S

# The decoder reads ticket before its switch and reuses that local.
type Spelling is Data:
  Spelling{name: String, type_name: String, read: String}

def spelling(f: S.Field) -> Spelling:
  match f:
    case S.Ticket{}:
      Spelling{"ticket", "bigint", "ticket"}
    case S.RouteIndex{}:
      Spelling{"routeIndex", "bigint", "L.getUsize(dv, L.HOST_ACTION_ROUTE_INDEX_OFF)"}
    case S.Session{}:
      Spelling{"session", "Ptr", "L.getPtr(dv, L.HOST_ACTION_SESSION_OFF)"}
    case S.Value{}:
      Spelling{"value", "Argument", "readArg(dv, L.HOST_ACTION_VALUE_OFF)"}
    case S.ResultCode{}:
      Spelling{"result", "number", "dv.getInt32(L.HOST_ACTION_RESULT_OFF, true)"}
    case S.Cause{}:
      Spelling{"cause", "RawBreakCause", "readBreakCause(dv, L.HOST_ACTION_CAUSE_OFF)"}
    case S.Message{}:
      Spelling{"message", "string", "view(L.HOST_ACTION_MESSAGE_OFF, L.HOST_ACTION_MESSAGE_LEN_OFF)"}

def spelled(fs: List<&2, S.Field>) -> List<&2, Spelling>:
  R.map(~S.Field, ~Spelling, ~spelling, fs)

def member(s: Spelling) -> String:
  Spelling{name, type_name, _} = s
  "; " ++ name ++ ": " ++ type_name

def init.pick(same: Bool, name: String, read: String) -> String:
  match same:
    case True{}:
      name
    case False{}:
      name ++ ": " ++ read

def init(s: Spelling) -> String:
  Spelling{+name, _, +read} = s
  init.pick(String.eq(name, read), name, read)

def const(a: S.Arm) -> String:
  +a = a
  "HOST_ACTION_" ++ S.name(a)

def kind(a: S.Arm) -> String:
  +a = a
  "typeof " ++ const(a)

def union(a: S.Arm) -> String:
  +a = a
  "\t| { kind: " ++ kind(a) ++ R.each(~Spelling, ~member, spelled(S.fields(a))) ++ " }"

def object(ss: List<&2, Spelling>) -> String:
  "{ " ++ String.join("kind" <> R.map(~Spelling, ~String, ~init, ss), ", ") ++ " }"

def decode(a: S.Arm) -> String:
  +a = a
  "\t\tcase " ++ const(a) ++ ":\n\t\t\treturn " ++ object(spelled(S.fields(a))) ++ ";\n"

def handler(a: S.Arm) -> String:
  +a = a
  "\t" ++ S.camel(a) ++ ": (action: Extract<HostAction, { kind: " ++ kind(a)
    ++ " }>) => void | Promise<void>;\n"

def dispatch(a: S.Arm) -> String:
  +a = a
  "\t\tcase " ++ const(a) ++ ":\n\t\t\tawait handlers." ++ S.camel(a) ++ "(action);\n\t\t\treturn;\n"

def import_line(name: String) -> String:
  "\t" ++ name ++ ",\n"

def imports(+arms: List<&2, S.Arm>) -> String:
  +names = List.append(&2, String, R.map(~S.Arm, ~String, ~const, arms), "INTERNAL" <> "INVALID_ARGUMENT" <> Nil{})
  R.each(~String, ~import_line, List.sort(~String, ~String.is_le, names))

def source(+arms: List<&2, S.Arm>) -> String:
  String.concat([
    "// GENERATED by `zig build gen-binding-host-action` from src/c_abi/host
// — do not edit.
// `zig build gen-binding-host-action-check` (part of `check`) fails when
// this is stale.
//
// Typed HostAction + decode for the TypeScript binding. Kind constant
// values live in `@glowcap/abi`; struct offsets come from the active
// layout `L` (the 64-bit mirror, or the wasm32 descriptor under the
// browser adapter). This file owns the discriminant union and the
// layout walk that copies borrowed views out before the next
// `glowcap_host_next_action` frees them.

import { L } from \"./layout.ts\";
import {
",
    imports(arms),
    "} from \"@glowcap/abi\";
import type { RawBreakCause } from \"@glowcap/abi\";
import { readBreakCause } from \"./break_cause.ts\";
import type { Ptr } from \"./ffi/runtime.ts\";
import { readBytes } from \"./seam.ts\";
import { readArg } from \"../abi_value.ts\";
import { GlowcapError } from \"../errors.ts\";
import type { Argument } from \"../value.ts\";

const utf8Decoder = new TextDecoder();

/** One popped embedder action, a discriminated union over the action
 * kind so each arm carries exactly the fields the C struct fills for
 * it. Every borrowed view is copied out (and a SETTLE's value lifted)
 * before the next `glowcap_host_next_action` call can free them. */
export type HostAction =
",
    R.joined(~S.Arm, ~union, "\n", arms) ++ ";\n",
    "
/** Decode a filled `GlowcapHostAction` buffer into an owned HostAction. */
export function decodeHostAction(dv: DataView): HostAction {
	const kind = dv.getUint32(L.HOST_ACTION_KIND_OFF, true);
	const ticket = dv.getBigUint64(L.HOST_ACTION_TICKET_OFF, true);
	const view = (off: number, lenOff: number): string =>
		utf8Decoder.decode(
			readBytes(L.getPtr(dv, off), L.getUsize(dv, lenOff)),
		);
	switch (kind) {
",
    R.each(~S.Arm, ~decode, arms),
    "		default:
			throw new GlowcapError(
				INTERNAL,
				`glowcap ABI returned unknown host action kind ${kind}`,
			);
	}
}

/** Exhaustive dispatch over `HostAction`: a new kind fails compile.
 * Bindings supply the per-arm I/O; this switch is the generated inventory. */
export type HostActionHandlers = {
",
    R.each(~S.Arm, ~handler, arms),
    "};

export async function dispatchHostAction(
	action: HostAction,
	handlers: HostActionHandlers,
): Promise<void> {
	switch (action.kind) {
",
    R.each(~S.Arm, ~dispatch, arms),
    "		default: {
			const _exhaustive: never = action;
			void _exhaustive;
			throw new GlowcapError(INVALID_ARGUMENT, \"unknown host action\");
		}
	}
}
"
  ])

def main() -> IO(Unit):
  IO.write(source(S.arms()))
