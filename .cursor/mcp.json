{
  "mcpServers": {
    "serena": {
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context",
        "ide",
        "--project",
        "${workspaceFolder}"
      ]
    },
    "pancake": {
      "command": "${workspaceFolder}/pancake",
      "args": ["mcp", "--tools", "default"]
    }
  }
}
