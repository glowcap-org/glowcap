# Copy to .env and set your values. .env is gitignored, so your infrastructure
# names never enter the repo. This example leaves the value empty on purpose.
#
# rooms-net (the fabric shared with the pancake devcontainer) has a fixed name;
# create it once with: docker network create rooms-net
#
# EGRESS_NET is this stack's one side network: the tunnel network cloudflared
# reaches the web UI on. Put the real name only in .env. (The devcontainer sets
# its own EGRESS_NET to a different value — the LLM backend — so these two do
# not match; the shared network is rooms-net.)
EGRESS_NET=
