#!/bin/sh
# The Rooms deployment's one operations front: everything an operator does to
# this stack from the machine that runs Docker. Plain sh, so it needs none of
# the devcontainer's toolchain, and the only script here that names the other
# machine's half of a redeploy.
#
#   ./ops doctor                    Which tools are here, what is prepared, what runs
#   ./ops up                        Set up once, check the preparation, start, print the handoff
#   ./ops redeploy                  zig build rooms-deploy-prep here, then up if this machine can
#   ./ops status                    Container and volume state
#   ./ops logs [service...]         Follow deployment logs
#   ./ops down                      Stop the deployment, keep every volume
#   ./ops reset <what> [--yes]      session | state | storage | all. Destroys durable state.
#   ./ops compose <args...>         Docker Compose with this deployment's files selected
#
# Every verb checks the tool it needs and says where to go when one is
# missing: `zig build rooms-deploy-prep` runs in the devcontainer, Docker
# runs on the host, and a redeploy is prepare there, then start here. A verb
# that cannot finish on this machine says so rather than reporting success
# for work that has not happened.
set -eu
cd "$(dirname "$0")"
repo_root=$(CDPATH='' cd -- ../../../.. && pwd)
deployment_version="$repo_root/zig-out/rooms-deployment.version"

fail() {
	echo "ops: $*" >&2
	exit 1
}
usage() {
	sed -n '2,/^set -eu/{/^#   \.\/ops/s/^# //p}' "$0" >&2
	exit 2
}
have() { command -v "$1" >/dev/null 2>&1; }
need() {
	have "$1" && return 0
	case "$1" in
	zig) fail "zig is not here; run this half inside the glowcap devcontainer" ;;
	docker) fail "docker is not here; run this on the Docker host, not in the devcontainer" ;;
	*) fail "$1 is not installed" ;;
	esac
}

# The base topology is tracked; host exposure and extra networks are the
# ignored override's. Compose's implicit .env discovery is off, so operator
# values arrive through the process environment unless the caller passes
# --env-file deliberately.
compose() {
	if [ -f docker-compose.override.yml ]; then
		COMPOSE_DISABLE_ENV_FILE=1 docker compose --project-directory "$PWD" \
			-f docker-compose.yml -f docker-compose.override.yml "$@"
	else
		COMPOSE_DISABLE_ENV_FILE=1 docker compose --project-directory "$PWD" \
			-f docker-compose.yml "$@"
	fi
}

assume_yes=no
confirm() {
	[ "$assume_yes" = yes ] && return 0
	printf 'ops: %s [y/N] ' "$1" >&2
	read -r answer </dev/tty || answer=
	case "$answer" in y | Y | yes | YES) return 0 ;; *) fail "cancelled" ;; esac
}

# One volume per custody unit. A suffix that matches nothing means the
# deployment was never created; one that matches several is left to a
# human, because removing the wrong one is not recoverable.
volume() {
	found=$(docker volume ls --quiet --filter "name=$1")
	[ -n "$found" ] || fail "no volume matching $1; is the deployment created?"
	[ "$(printf '%s\n' "$found" | wc -l)" -eq 1 ] ||
		fail "more than one volume matches $1; remove the right one by hand:
$found"
	printf '%s\n' "$found"
}

# Bound every post-health Docker read. A container can wedge after its last
# probe, and a retry count around an unbounded Compose exec is not a
# deadline. TERM gives the CLI a moment to unwind; KILL makes the bound hard.
bounded() {
	"$@" &
	command_pid=$!
	(
		sleep 15
		kill -TERM "$command_pid" 2>/dev/null || exit 0
		sleep 2
		kill -KILL "$command_pid" 2>/dev/null || true
	) &
	timer_pid=$!
	if wait "$command_pid"; then result=0; else result=$?; fi
	kill -TERM "$timer_pid" 2>/dev/null || true
	wait "$timer_pid" 2>/dev/null || true
	return "$result"
}

prep() {
	need zig
	if [ -n "$(git -C "$repo_root" status --porcelain)" ]; then
		echo "ops: the checkout has local changes; up will refuse it" >&2
		echo "ops: commit the intended source first, then prepare" >&2
	fi
	(cd "$repo_root" && zig build rooms-deploy-prep)
	echo "ops: prepared $(sed -n '1p' "$deployment_version" 2>/dev/null || echo unknown)"
}

# A deployment runs exactly the source it claims. The preparation's revision
# is written only after every mounted artifact finished, so a failed or
# partial preparation cannot authorize the checkout, and local changes have no
# revision to claim at all.
check_prepared() {
	[ -z "$(git -C "$repo_root" status --porcelain)" ] ||
		fail "refusing to deploy a checkout with local changes; commit the intended source, then run: zig build rooms-deploy-prep"
	source_version=$(git -C "$repo_root" rev-parse --short=12 HEAD)
	prepared_version=$(sed -n '1p' "$deployment_version" 2>/dev/null || true)
	[ "$prepared_version" = "$source_version" ] ||
		fail "prepared deployment ${prepared_version:-missing} does not match checkout $source_version; run: zig build rooms-deploy-prep"
	browser_version=$(sed -n '2p' "$deployment_version")
	selected_version=$(cat "$repo_root/zig-out/rooms-web/current/source.version" 2>/dev/null || true)
	[ -n "$browser_version" ] && [ "$selected_version" = "$browser_version" ] ||
		fail "selected browser assets do not match the prepared deployment; run: zig build rooms-deploy-prep"
}

# The history database's one password lives in a file Git ignores, mounted
# into both containers as a Docker secret. Mint it once, here, so nobody has
# to invent or export one: 32 bytes of the kernel's randomness as hex, which
# needs no URL encoding and no quoting anywhere it is read. The file is
# created closed to everyone but its owner before a byte is written, and an
# existing file is never touched, because the database already knows it.
mint_secret() {
	secret_file=secrets/storage-db-password
	[ -s "$secret_file" ] && return 0
	mkdir -p secrets
	(
		umask 077
		od -An -N32 -tx1 /dev/urandom | tr -d ' \n' >"$secret_file.new" &&
			printf '\n' >>"$secret_file.new" &&
			mv "$secret_file.new" "$secret_file"
	) || fail "could not mint $secret_file"
	echo "ops: minted the history database password into $secret_file (keep it with your backups)"
}

# Compose has already joined every declared healthcheck. Read each ready
# value once rather than keeping a second polling state machine. The session
# runtime can still be between internal incarnations while Compose reports
# its last good probe, and its tmpfs marker is removed before each retry, so
# that one read gets a fixed, bounded window.
read_session_capability() {
	attempt=1
	while [ "$attempt" -le 6 ]; do
		if capability=$(bounded compose exec -T rooms-session /runtime/bin/rooms-session --check-ready=/run/rooms-session/admin.sturdyref 2>/dev/null) &&
			[ -n "$capability" ]; then
			printf '%s\n' "$capability"
			return 0
		fi
		[ "$attempt" -eq 6 ] && return 1
		attempt=$((attempt + 1))
		sleep 2
	done
}

# Setup is idempotent and not policy: the shared network exists or is
# created, and an absent override is seeded from its tracked example, which
# publishes loopback only. An override already here is the operator's and is
# left exactly as written. Then the strict part: refuse anything but the
# prepared, committed source, start, wait for health, and hand off every
# bearer authority in one block an operator can copy or save as one value.
up() {
	need docker
	docker network inspect rooms-net >/dev/null 2>&1 || docker network create rooms-net >/dev/null
	if [ ! -f docker-compose.override.yml ]; then
		cp docker-compose.override.yml.example docker-compose.override.yml
		echo "ops: created docker-compose.override.yml from the example (loopback only)"
	fi
	check_prepared
	mint_secret
	# Both services allow a 90-second cold start, then three 30-second health
	# intervals with bounded 10-second probes. Compose's outer deadline stays
	# beyond that declared budget so a service cannot be failed just before
	# its final useful probe, while remaining decisively finite.
	compose up -d --build --force-recreate --wait --wait-timeout 210 ||
		fail "the deployment did not become healthy within its 210-second health budget; read: ./ops logs"
	locator=$(bounded compose exec -T rooms /runtime/bin/rooms-web --locator) ||
		fail "the healthy server did not answer its locator; read: ./ops logs rooms"
	ui_version=$(bounded compose exec -T rooms /runtime/bin/rooms-web --ui-version) ||
		fail "the healthy server did not answer its UI version; read: ./ops logs rooms"
	session_capability=$(read_session_capability) ||
		fail "the healthy shared session did not expose its administrator capability; read: ./ops logs rooms-session"
	directory_capabilities=$(bounded compose exec -T rooms /runtime/bin/rooms-server --capabilities) ||
		fail "the capability printer could not read the state volume; read: ./ops logs rooms"
	printf '\n%s\n\n%s\n%s\n\n%s\n%s\n\n%s\n%s\n\n%s\n%s\n%s\n' \
		"ops: deployment handoff" \
		"Directory operator capabilities:" \
		"$directory_capabilities" \
		"Room locator (what a terminal peer dials):" \
		"$locator" \
		"Browser interface build (shown at the bottom of Help):" \
		"$ui_version" \
		"Shared-session administrator capability:" \
		"Paste this into Choose a session -> Shared session; it grants full control of that workspace." \
		"$session_capability"
}

doctor() {
	echo "roots"
	printf '  checkout  %s\n  deploy    %s\n' "$repo_root" "$(pwd)"
	echo "tools"
	for tool in zig docker; do
		if have "$tool"; then printf '  %-8s %s\n' "$tool" "$(command -v "$tool")"; else printf '  %-8s absent\n' "$tool"; fi
	done
	echo "preparation"
	prepared=$(sed -n '1p' "$deployment_version" 2>/dev/null || true)
	checkout=$(git -C "$repo_root" rev-parse --short=12 HEAD 2>/dev/null || echo unknown)
	printf '  prepared  %s\n  checkout  %s%s\n' "${prepared:-none}" "$checkout" \
		"$([ -n "$(git -C "$repo_root" status --porcelain 2>/dev/null)" ] && echo ' (local changes; up refuses)' || echo '')"
	echo "host setup"
	printf '  override  %s\n' "$([ -f docker-compose.override.yml ] && echo present || echo 'absent; ./ops up seeds it from the example')"
	printf '  secret    %s\n' "$([ -s secrets/storage-db-password ] && echo 'minted' || echo 'absent; ./ops up mints it')"
	if have docker; then
		printf '  network   %s\n' "$(docker network inspect rooms-net >/dev/null 2>&1 && echo rooms-net || echo 'absent; ./ops up creates it')"
		echo "deployment"
		compose ps 2>/dev/null || echo "  not created"
	fi
}

reset() {
	# --yes answers this verb's own confirmation and is the only flag it takes.
	what=
	for arg in "$@"; do
		case "$arg" in
		--yes | -y) assume_yes=yes ;;
		session | state | storage | all) [ -z "$what" ] || usage; what=$arg ;;
		*) usage ;;
		esac
	done
	[ -n "$what" ] || usage
	need docker
	case "$what" in
	session)
		confirm "destroy the shared workspace? Its session capability is minted fresh and must be attached again."
		compose down
		docker volume rm "$(volume rooms_rooms-session-state)"
		;;
	state)
		confirm "destroy the room server's state? Its identity, operator capabilities, and room links go with it."
		compose down
		docker volume rm "$(volume rooms_rooms-state)"
		;;
	storage)
		confirm "destroy the history database? Every kept room line goes with it; dump it first if it matters."
		compose down
		docker volume rm "$(volume rooms_rooms-storage-db)"
		;;
	all)
		confirm "destroy every volume this deployment declares: state, session, history, and caches?"
		compose down -v
		;;
	esac
	up
}

verb=${1:-}
[ $# -gt 0 ] && shift
case "$verb" in
doctor) doctor ;;
up) up ;;
redeploy)
	# The two halves live on different machines. Do the half this machine can
	# do, then say plainly what is left.
	if have zig; then prep; fi
	if have docker; then
		up
	else
		echo
		echo "ops: prepared here. Docker is elsewhere, so finish on the host with:"
		echo "    apps/rooms/web/deploy/ops up"
	fi
	;;
status)
	need docker
	compose ps
	echo
	docker volume ls --filter name=rooms_
	;;
logs)
	need docker
	if [ $# -eq 0 ]; then compose logs -f rooms rooms-session rooms-storage-db; else compose logs -f "$@"; fi
	;;
down)
	need docker
	compose down
	;;
reset) reset "$@" ;;
compose)
	need docker
	compose "$@"
	;;
*) usage ;;
esac
