# Copied once to docker-compose.override.yml by `glowcap apps rooms deployment
# up`, and never rewritten. Every setting this host chooses lives here. The
# managed compose.yml is replaced on each `up`, so a change there is lost.
#
# There are two ways to the page, and a host may use either or both. A
# published loopback port reaches it from a browser on this machine. A shared
# Docker network reaches it from a reverse proxy or tunnel container beside it,
# which sends plain HTTP to http://glowcap-rooms-directory:8080 and needs no
# published port.
services:
  directory:
    # Keep the interface named. Dropping the `127.0.0.1:` prefix publishes the
    # page on every interface this machine has, including its LAN address. A
    # different host port also needs GLOWCAP_ROOMS_HTTP_PUBLIC below, or the
    # printed links keep naming port 8080.
    ports:
      - "127.0.0.1:8080:8080"
    # Public hosting behind an HTTPS proxy. Replace rooms.example with the
    # address people open. The proxy must pass WebSocket upgrades and the
    # original Host header. Uncomment `environment:` together with any line
    # below it.
    # environment:
    #   # The address browsers reach this server at, named by every link it prints.
    #   GLOWCAP_ROOMS_HTTP_PUBLIC: "https://rooms.example/"
    #   # Charge each client its own HTTP allowance, reading the client address
    #   # from X-Forwarded-For when the proxy is this address. Name the address
    #   # the container sees the proxy at. For a proxy on this host that is the
    #   # network's gateway, which this prints:
    #   #   docker network inspect glowcap-rooms-net --format '{{(index .IPAM.Config 0).Gateway}}'
    #   # A range would trust every container on the network, terminal peers included.
    #   GLOWCAP_ROOMS_HTTP_ADMISSION_PER_ADDRESS: "true"
    #   GLOWCAP_ROOMS_HTTP_TRUSTED_PROXIES: "172.18.0.1"
    #   # Other Rooms pages that may use this server. Unset, only the published
    #   # glowcap.org page is allowed, and setting this replaces that default.
    #   GLOWCAP_RELAY_ALLOW_ORIGINS: "https://glowcap.org/rooms/app/"
    #   # Public WebSocket routes for trace viewers and session producers.
    #   GLOWCAP_ROOMS_TRACE_CONNECT: "wss://rooms.example/trace/captp"
    #   GLOWCAP_ROOMS_TRACE_PUBLISH: "wss://rooms.example/publish"
    #   # List the operator capabilities this deployment mints. This one
    #   # leaves IRC out.
    #   GLOWCAP_ROOMS_CAPABILITIES: "admin-listeners,diagnostics,operator,peering,trace"
    # Also join the network the proxy or tunnel already runs on. Keep
    # glowcap-rooms-net in the list, since terminal peers on this host reach
    # the directory over it.
    # networks:
    #   - glowcap-rooms-net
    #   - site-ingress
  # session:
  #   environment:
  #     # Behind a browser login, the session reaches the public relay address
  #     # through the private network.
  #     GLOWCAP_ROOMS_SESSION_RELAY_ALIAS_URL: "wss://rooms.example/relay"

  # Run a bot: a member of Rooms whose replies come from a coding agent. The
  # Rooms deployment guide's "Run a bot" section gives the order. Uncomment
  # the bot session and the volumes first, run `up`, and issue the bot's
  # link. Then uncomment the bot and its secret, and run `up` again. Each
  # heading below marks one piece. Uncomment the lines under it.
  # == bot session ==
  # bot-session:
  #   # The bot speaks as this session, which has its own nickname and rooms.
  #   # It runs the same image as the shared session, and the guide's second
  #   # step gives it its nickname.
  #   image: ${GLOWCAP_ROOMS_IMAGE}
  #   container_name: glowcap-rooms-bot-session
  #   working_dir: /runtime
  #   entrypoint: ["/runtime/bin/glowcap", "apps", "rooms", "session", "serve"]
  #   command:
  #     - --dir=/session-state
  #     - --readiness-file=/run/rooms-session/use.sturdyref
  #   environment:
  #     GLOWCAP_LIB_DIR: /runtime/lib
  #     GLOWCAP_ROOMS_SESSION_STATE: /session-state
  #     GLOWCAP_ROOMS_SESSION_TRANSPORT: iroh
  #     GLOWCAP_ROOMS_SESSION_REACHABILITY: discovery
  #     GLOWCAP_ROOMS_SESSION_RELAY_URL: ws://directory:8080/relay
  #   volumes:
  #     - bot-session-state:/session-state
  #   tmpfs:
  #     - /run/rooms-session:mode=0700
  #   healthcheck:
  #     test: ["CMD", "/runtime/libexec/rooms-session", "--check-ready=/run/rooms-session/use.sturdyref"]
  #     interval: 30s
  #     timeout: 10s
  #     retries: 3
  #     start_period: 90s
  #   restart: unless-stopped
  #   networks:
  #     - glowcap-rooms-net
  # == bot ==
  # bot:
  #   # The operator's own image, built from bot-image/Dockerfile in this directory,
  #   # a copy of bot.Dockerfile.example from the installation's
  #   # share/glowcap/deployment directory.
  #   # It copies /runtime from the selected Rooms image, which `up` also names
  #   # glowcap-rooms:selected because a build cannot take an image ID. So
  #   # `pull_policy: build` rebuilds it on every `up` and it follows an upgrade.
  #   build:
  #     context: ./bot-image
  #     args:
  #       GLOWCAP_ROOMS_IMAGE: glowcap-rooms:selected
  #       # The agent's npm package and the directory it keeps its
  #       # configuration in, from the deployment guide's agent table.
  #       AGENT_PACKAGE: "@anthropic-ai/claude-code"
  #       AGENT_DIR: .claude
  #   image: glowcap-rooms-bot
  #   pull_policy: build
  #   container_name: glowcap-rooms-bot
  #   cap_drop: ["ALL"]
  #   security_opt: ["no-new-privileges:true"]
  #   entrypoint: ["/runtime/bin/glowcap", "apps", "rooms", "bot", "serve"]
  #   command:
  #     - --dir=/bot-state
  #   # Each setting below is a variable too, by the rule in the bot guide's
  #   # "Settings as variables" section. These are stored in the bot volume on
  #   # the first start.
  #   environment:
  #     GLOWCAP_LIB_DIR: /runtime/lib
  #     # The agent: claude, codex, or pi. The bot guide's "Choosing the
  #     # agent and its permission" section says which needs full.
  #     GLOWCAP_ROOMS_BOT_HARNESS: claude
  #     # What the agent may do: safe or full, as the bot guide's "Choosing
  #     # the agent and its permission" section says.
  #     GLOWCAP_ROOMS_BOT_PERMISSION: safe
  #     # The agent's own provider and model syntax. Unset, the agent's default.
  #     # GLOWCAP_ROOMS_BOT_MODEL: ""
  #     # Messages in one conversation the bot answers in an hour.
  #     # GLOWCAP_ROOMS_BOT_CONVERSATION_LIMIT: "60"
  #     # Your own instructions for the agent, read for every reply, from
  #     # the file mounted below.
  #     # GLOWCAP_ROOMS_BOT_INSTRUCTIONS: /bot-instructions.md
  #     # The access link is read from this file, never from a variable.
  #     GLOWCAP_ROOMS_BOT_LINK: /run/secrets/bot-link
  #   secrets:
  #     - bot-link
  #   volumes:
  #     - bot-state:/bot-state
  #     # The bot's home, its own volume so a fresh start keeps it. To keep
  #     # it on this host instead, replace this line with a directory owned
  #     # by the container user:
  #     # - ./bot/home:/bot-state/home
  #     - bot-home:/bot-state/home
  #     # The agent's sign-in and configuration under the container user's
  #     # home. Mount only what the agent needs, from copies kept in this
  #     # directory. Claude Code replaces its sign-in file when it refreshes
  #     # its token, so its directory is writable and owned by the container
  #     # user. A read-only or single-file mount stops the bot answering once
  #     # the first token expires. For example:
  #     # - ./bot/claude:/home/node/.claude
  #     # - ./bot/instructions.md:/bot-instructions.md:ro
  #   # The bot reaches its session over iroh, an encrypted peer-to-peer
  #   # transport, so it needs none of this deployment's networks. To reach a
  #   # model server that listens only on this host's loopback, replace the
  #   # default network with the host's:
  #   # network_mode: host
  #   # To reach one that listens on the Docker bridge gateway or every
  #   # interface, name the host and use http://host.docker.internal:<port>:
  #   # extra_hosts:
  #   #   - "host.docker.internal:host-gateway"
  #   depends_on:
  #     bot-session:
  #       condition: service_healthy
  #   healthcheck:
  #     test: ["CMD", "/runtime/bin/glowcap", "apps", "rooms", "bot", "ready", "--dir=/bot-state"]
  #     interval: 30s
  #     timeout: 10s
  #     retries: 3
  #     start_period: 90s
  #   restart: unless-stopped

# The site network is declared here as well, so Compose knows it is managed
# outside this file. Give `name` whatever `docker network ls` calls it.
# networks:
#   site-ingress:
#     name: site-ingress
#     external: true

# The bot's three volumes. Uncomment these with the bot session.
# == bot volumes ==
# volumes:
#   bot-session-state:
#     name: glowcap-rooms-bot-session-state
#   bot-state:
#     name: glowcap-rooms-bot-state
#   bot-home:
#     name: glowcap-rooms-bot-home

# The bot's access link, one file the guide's third step writes. Uncomment it
# with the bot.
# == bot secret ==
# secrets:
#   bot-link:
#     file: ./secrets/bot-link
