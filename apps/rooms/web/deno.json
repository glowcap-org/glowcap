{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/main/cli/schemas/config-file.v1.json",
  "license": "Apache-2.0",
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check dev.ts dev_test.ts dev_process_test.ts vite.config.ts ui/main.tsx ui/ground.js && deno test -A"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react"
  },
  "imports": {
    "@glowcap/abi": "../../../bindings/ts/abi/constants.ts",
    "@glowcap/runtime/cleanup": "../../../bindings/ts/runtime/cleanup.ts",
    // dep react: The UI library for the Rooms web client.
    "react": "npm:react@19.3.0",
    // dep @types/react: React's types for the type checker.
    "@types/react": "npm:@types/react@19.3.0",
    // dep @types/react-dom: React DOM's types for the type checker.
    "@types/react-dom": "npm:@types/react-dom@19.3.0",
    "react/jsx-runtime": "npm:react@19.3.0/jsx-runtime",
    // dep react-dom: Renders the Rooms web client in the browser.
    "react-dom": "npm:react-dom@19.3.0",
    "react-dom/client": "npm:react-dom@19.3.0/client",
    // dep react-router: Routes between Rooms views.
    "react-router": "npm:react-router@8.4.0",
    // dep zustand: Holds Rooms client state.
    "zustand": "npm:zustand@5.0.15",
    "zustand/vanilla": "npm:zustand@5.0.15/vanilla",
    "zustand/react/shallow": "npm:zustand@5.0.15/react/shallow",
    // dep zod: Validates data at the Rooms web client's boundaries.
    "zod/mini": "npm:zod@4.6.5/mini",
    // dep vite: Builds and serves the Rooms web client.
    "vite": "npm:vite@8.3.4",
    // dep @vitejs/plugin-react: Vite's React support.
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@6.1.2",
    // dep @deno/vite-plugin: Lets Vite resolve Deno imports.
    "@deno/vite-plugin": "npm:@deno/vite-plugin@2.0.4",
    // dep @std/assert: Test assertions.
    "@std/assert": "jsr:@std/assert@1.0.19"
  },
  "lock": {
    "path": "./deno.lock",
    "frozen": true
  },
  "fmt": {
    "lineWidth": 120,
    "semiColons": true,
    "singleQuote": false,
    "include": [
      "dev.ts",
      "dev_test.ts",
      "dev_process_test.ts",
      "vite.config.ts",
      "ui/**/*.js",
      "ui/**/*.ts",
      "ui/**/*.tsx"
    ]
  },
  "lint": {
    "include": ["dev.ts", "dev_test.ts", "dev_process_test.ts", "vite.config.ts", "ui/"],
    "rules": {
      "tags": ["recommended", "react"]
    }
  },
  "test": {
    "include": ["dev_test.ts", "dev_process_test.ts"]
  },
  "exclude": ["node_modules"]
}
