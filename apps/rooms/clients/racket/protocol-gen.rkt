(define MEMBERSHIP-ENDED "membershipEnded")

;; The membership verbs and whether the seat answers each.
(define MEMBERSHIP-VERBS
  (list
   (cons 'post #t)
   (cons 'leave #t)
   (cons 'typing #f)
   (cons 'away #t)))

(define MEMBERSHIP-KINDS '("observer" "participant"))
(define PUBLICATION-KINDS '("local" "foreign" "bridge"))
(define PUBLICATION-PROOFS '("local" "authenticated" "session" "bridge"))
(define SEAT-PHASES '("rooms" "connecting" "linked" "failed"))

;; One directory publication: a listPublications row, and what a room watch kind carries after its tag.
(define PUBLICATION-FIELDS
  (list
   (field "name" 'text #f '())
   (field "count" 'natural #t '())
   (field "id" 'text #f '())
   (field "kind" 'text #f PUBLICATION-KINDS)
   (field "origin" 'string #f '())
   (field "proof" 'text #f PUBLICATION-PROOFS)
   (field "offers" 'text #t MEMBERSHIP-KINDS)))

;; What a member watch kind carries after its tag.
(define REGISTRATION-EVENT-FIELDS
  (list
   (field "name" 'text #f '())
   (field "count" 'natural #f '())
   (field "registrationId" 'registration-id #f '())))

;; What the truncation watch kind carries after its tag.
(define TRUNCATED-FIELDS
  (list
   (field "omitted" 'natural #f '())))

;; What watchPublications answers: the baseline a watcher folds deltas into.
(define WATCH-SNAPSHOT-FIELDS
  (list
   (field "rooms" 'list #f '())
   (field "registrations" 'list #f '())
   (field "omitted" 'natural #f '())))

;; One row of the snapshot's registrations.
(define REGISTRATION-ROW-FIELDS
  (list
   (field "name" 'text #f '())
   (field "registrationId" 'registration-id #f '())))

;; What subscribe answers.
(define SUBSCRIBE-ANSWER-FIELDS
  (list
   (field "seat" 'reference #f '())
   (field "kind" 'text #f MEMBERSHIP-KINDS)
   (field "topic" 'reference #t '())
   (field "files" 'reference #t '())))

;; After the line tag: the line's id, then the file records apps/rooms/lib/attachment.ts reads.
(define LINE-TRAILING
  (list
   (field "id" 'natural #f '())))

;; After a join or leave tag: the member.
(define NAMED-TRAILING
  (list
   (field "name" 'text #f '())))

;; After the typing tag: the member and whether they are typing.
(define TYPING-TRAILING
  (list
   (field "name" 'text #f '())
   (field "on" 'boolean #f '())))

;; After the away tag: the member and the reason, empty when they are back.
(define AWAY-TRAILING
  (list
   (field "name" 'text #f '())
   (field "reason" 'string #f '())))

;; After the bridge's seat tag, specified in apps/rooms/lib/protocol_irc.ts.
(define SEAT-TRAILING
  (list
   (field "name" 'text #f '())
   (field "state" 'text #f SEAT-PHASES)
   (field "nick" 'text #f '())
   (field "network" 'text #f '())
   (field "badge" 'text #f '())
   (field "said" 'text #f '())))

;; The directory watch notifications.
(define WATCH-KINDS
  (list
   (watch-kind "opened" PUBLICATION-FIELDS #t)
   (watch-kind "closed" PUBLICATION-FIELDS #t)
   (watch-kind "count" PUBLICATION-FIELDS #t)
   (watch-kind "registered" REGISTRATION-EVENT-FIELDS #f)
   (watch-kind "unregistered" REGISTRATION-EVENT-FIELDS #f)
   (watch-kind "truncated" TRUNCATED-FIELDS #f)))

;; What rides after a room line's display text.
(define ROOM-TAILS
  (list
   (room-tail "line" LINE-TRAILING 'any 'either 'any #f)
   (room-tail "roster" '() 'text 'room 'any 'arrive)
   (room-tail "join" NAMED-TRAILING #f 'room 'any 'arrive)
   (room-tail "leave" NAMED-TRAILING #f 'room 'any 'depart)
   (room-tail "typing" TYPING-TRAILING #f 'room 'empty 'stay)
   (room-tail "away" AWAY-TRAILING #f 'room 'any 'stay)
   (room-tail "seat" SEAT-TRAILING #f 'room 'any 'stay)
   (room-tail "membershipEnded" '() #f 'room 'nonempty #f)))

