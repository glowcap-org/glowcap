{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/main/cli/schemas/config-file.v1.json",
  "license": "Apache-2.0",
  "tasks": {
    "check": "deno task static && deno task test",
    "static": "deno fmt --check && deno lint && deno check lib clients demos irc test tools web rust/proofs/browser",
    "test": "deno test -A web/dev_test.ts web/dev_process_test.ts"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react",
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable"
    ]
  },
  "imports": {
    "@glowcap/abi": "../../bindings/ts/abi/constants.ts",
    "@glowcap/runtime/cleanup": "../../bindings/ts/runtime/cleanup.ts",
    "@glowcap/runtime/text": "../../bindings/ts/runtime/text.ts",
    "@glowcap/runtime": "../../bindings/ts/runtime/mod.ts",
    "@glowcap/runtime/ffi": "../../bindings/ts/runtime/ffi.ts",
    "@glowcap/runtime/adapter": "../../bindings/ts/runtime/adapter.ts",
    "@glowcap/runtime/websocket": "../../bindings/ts/runtime/websocket.ts",
    "@glowcap/runtime/transport": "../../bindings/ts/runtime/transport.ts",
    "@glowcap/inproc": "../../bindings/ts/inproc/mod.ts",
    "@glowcap/onion": "../../bindings/ts/onion/mod.ts",
    "@glowcap/tcp": "../../bindings/ts/tcp/mod.ts",
    "@glowcap/tcp/transport": "../../bindings/ts/tcp/transport.ts",
    "@glowcap/iroh": "../../bindings/ts/iroh/mod.ts",
    "@glowcap/iroh/internal": "../../bindings/ts/iroh/internal.ts",
    "@glowcap/relay": "../../bindings/ts/relay/mod.ts",
    "@glowcap/web": "../../bindings/ts/web/mod.ts",
    "@glowcap/webrtc": "../../bindings/ts/webrtc/mod.ts",
    "@glowcap/webrtc/driver": "../../bindings/ts/webrtc/driver.ts",
    // dep react: The UI library for the Rooms web client.
    "react": "npm:react@19.3.0",
    // dep @types/react: React's types for the type checker.
    "@types/react": "npm:@types/react@19.3.0",
    // dep @types/react-dom: React DOM's types for the type checker.
    "@types/react-dom": "npm:@types/react-dom@19.3.0",
    "react/jsx-runtime": "npm:react@19.3.0/jsx-runtime",
    // dep react-dom: Renders the Rooms web client in the browser.
    "react-dom": "npm:react-dom@19.3.0",
    "react-dom/client": "npm:react-dom@19.3.0/client",
    "react-dom/server": "npm:react-dom@19.3.0/server",
    // dep react-router: Routes between Rooms views.
    "react-router": "npm:react-router@8.4.0",
    // dep zustand: Holds Rooms client state.
    "zustand": "npm:zustand@5.0.15",
    "zustand/vanilla": "npm:zustand@5.0.15/vanilla",
    "zustand/react/shallow": "npm:zustand@5.0.15/react/shallow",
    // dep zod: Validates Rooms data in the browser, clients, and tests.
    "zod": "npm:zod@4.6.5",
    "zod/mini": "npm:zod@4.6.5/mini",
    // dep vite: Builds and serves the Rooms web client.
    "vite": "npm:vite@8.3.4",
    // dep @vitejs/plugin-react: Vite's React support.
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@6.1.2",
    // dep @deno/vite-plugin: Lets Vite resolve Deno imports.
    "@deno/vite-plugin": "npm:@deno/vite-plugin@2.0.4",
    // dep @std/assert: Test assertions.
    "@std/assert": "jsr:@std/assert@1.0.19",
    // dep playwright: Drives the browser tests.
    "playwright": "npm:playwright@1.64.0",
    // dep es-module-lexer: Reads import graphs in Rooms bundle tests.
    "es-module-lexer": "npm:es-module-lexer@3.0.3/minimal",
    // dep @std/jsonc: Reads the Rooms project manifest in browser package tests.
    "@std/jsonc": "jsr:@std/jsonc@1.0.3"
  },
  "lock": {
    "path": "./deno.lock",
    "frozen": true
  },
  "fmt": {
    "lineWidth": 120,
    "semiColons": true,
    "singleQuote": false,
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.mjs"
    ],
    "exclude": [
      "**/target",
      "**/node_modules",
      "**/*.yml",
      "**/*.yaml",
      "**/*.md",
      "**/*.json"
    ]
  },
  "lint": {
    "include": [
      "lib/",
      "clients/",
      "demos/",
      "irc/",
      "test/",
      "tools/",
      "rust/proofs/browser/",
      "web/"
    ],
    "rules": {
      "tags": [
        "recommended",
        "react"
      ]
    }
  },
  "test": {
    "include": [
      "web/dev_test.ts",
      "web/dev_process_test.ts"
    ]
  },
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/target"
  ]
}
