.zig-cache/
zig-out/
.DS_Store
# Zig extracts fetched packages into a `zig-pkg/` dir under the build that
# declares them (`site/zig-pkg/`, `tools/consumer/zig-pkg/`) unless
# ZIG_LOCAL_PKG_DIR redirects it. Generated, never committed.
zig-pkg/
# Zine's default output directory: `zig build site` renders into the install
# prefix (zig-out/site), but a direct `zine`/`docs-serve` run writes the same
# generated HTML to site/public/. Generated, never committed.
site/public/
bindings/rust/Cargo.lock
bindings/rust/target/
bindings/rust/relay/Cargo.lock
bindings/rust/relay/target/
apps/*/rust/Cargo.lock
apps/rooms/clients/rust/Cargo.lock
apps/*/rust/target/
apps/rooms/clients/rust/target/
bench/langs/clients/rust_bench/Cargo.lock
bench/langs/clients/rust_bench/target/
# transports/iroh/Cargo.lock is deliberately committed (see its Cargo.toml):
# the sidecar's external dependency tree must resolve identically everywhere.
transports/iroh/target/
# transports/webrtc/Cargo.lock is likewise committed (ADR-0089): the webrtc
# crate's large tree (DTLS, SCTP, ICE, STUN, SDP) must resolve identically.
transports/webrtc/target/

# binding consumer caches
**/__pycache__/
**/*.pyc
# The Python binding lock is committed: relay and rendezvous proofs run its
# optional WebSocket dependency with `uv --locked`.
bindings/python/pancake_python.egg-info/
# Deno lockfiles are committed beside each config. Direct versions are exact,
# and the frozen transitive graph is part of reproducible checks and bundles.
# Racket bytecode: compiling a Racket source (bench-langs precompiles its
# clients so cold-start measures startup, not recompilation) writes a
# `compiled/` dir of `.zo`/`.dep` next to that source and every dependency it
# reaches, the binding, the binding's `private/`, the shared metrics, and the
# goblins-peer sources. Generated, never committed, wherever it lands.
**/compiled/

# accountability-on-pancake writes its durable Episode log + transparency root
# here at run time; generated state, never committed.
apps/accountability-on-pancake/.data/
# The Goblins-side kernel and three-vat demos write the same shape, including
# per-AID KERI key files; one early round of them survives only in history,
# named in that app's README.
conformance/accountability-on-goblins/.data/
conformance/accountability-on-goblins/racket/tests/.data/

# The Rooms browser UI is code-split under ui/bundle, built on the fly in
# development or prepared ahead of the network-free deployment.
apps/rooms/web/ui/bundle/
# Older local builds may still have the former single-file artifact.
apps/rooms/web/ui/page.js

# local scratch: reference clones, throwaway experiments, MCP CapTP state (never committed)
.local/
# Written by `deno task stress-tests` from a fixed seed, so the generator is the
# artifact worth keeping and these are reproducible byte-for-byte on demand.
# Together they are about 8MB; the 64x one alone is 4.4MB.
apps/ocapnviz/test-data/stress-*x.json

# Cold-cache fallback when HOME is unset (see bindings/c-abi-resolve.json
# `fallback_cache_name`; written under $TMPDIR / the process cwd as appropriate).
pancake-c-abi-cache/

# per-machine agent-harness settings, never committed
.claude/settings.local.json

# local env files carry per-host infrastructure names; only .env.example is tracked
.env
.worktrees/

# Rooms host exposure is a machine-local Compose choice. The tracked example
# documents the shape; compose.sh explicitly adds the ignored file when present.
apps/rooms/web/deploy/docker-compose.override.yml

# per-worktree grid pane configuration for enter-grid.sh; only
# panes.example.sh is tracked
.devcontainer/pane/panes.sh
.devcontainer/pane/panes-*.sh

# zsh completion cache the container shell writes beside its .zshrc, named
# for the container and zsh version; generated per machine, never committed
.devcontainer/pane/container/.zcompdump*

# captured stderr from a redirected demo/test run; scratch, never committed
*.err

# ocapnviz runs on its own Deno toolchain; its dependency and build caches
# are generated state.
apps/ocapnviz/node_modules/
apps/ocapnviz/.vite/
apps/ocapnviz/vite.config.ts.timestamp-*.mjs
