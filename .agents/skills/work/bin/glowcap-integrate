#!/usr/bin/env bash
set -euo pipefail

die() {
	echo "glowcap-integrate: $*" >&2
	exit 1
}

usage="usage: glowcap-integrate [--sync | -m <subject>]"
mode=publish
subject=
case ${1:-} in
	"") [[ $# -eq 0 ]] || die "${usage}" ;;
	--sync)
		[[ $# -eq 1 ]] || die "${usage}"
		mode=sync
		;;
	-m)
		[[ $# -eq 2 && -n ${2} ]] || die "${usage}"
		subject=$2
		;;
	*) die "${usage}" ;;
esac

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a Git worktree"
cd "${repo_root}"

branch_ref=$(git symbolic-ref --quiet HEAD) || die "detached HEAD has no worktree branch to integrate"
branch=${branch_ref#refs/heads/}
case "${branch}" in
	main | dev) die "run from the worktree's own branch, not ${branch}" ;;
esac

git show-ref --verify --quiet refs/heads/main || die "local main ref is missing"
git show-ref --verify --quiet refs/heads/dev || die "local dev ref is missing"

if [[ -n $(git status --porcelain --untracked-files=normal) ]]; then
	die "working tree is not clean; commit only your owned paths before integration"
fi

require_unchecked_dev() {
	[[ ${mode} == publish ]] || return 0
	local worktrees
	worktrees=$(git worktree list --porcelain) || die "cannot inspect worktree branches"
	if grep -Fxq 'branch refs/heads/dev' <<<"${worktrees}"; then
		"${1:-die}" "dev is checked out; switch that checkout off dev before publishing so its index and files cannot become stale"
	fi
}

require_unchecked_dev

input_head=$(git rev-parse HEAD)

refuse_publication() {
	# Rebasing prepares publication but must not consume a refused input.
	# Refuse to rewind if another writer changed this worktree meanwhile.
	if [[ $(git symbolic-ref --quiet HEAD) != "${branch_ref}" ||
		$(git rev-parse HEAD) != "${head}" ||
		-n $(git status --porcelain --untracked-files=normal) ]]; then
		die "publication refused; worktree changed during preparation, so its rebased state was preserved: $*"
	fi
	git reset -q --keep "${input_head}" || die "publication refused; could not restore the input worktree: $*"
	die "$*"
}

# Two worktrees can each take the next decision record number from the dev
# they observed. The rebase below merges both files cleanly, so the duplicate
# is only visible on the rebased tree, and this check refuses it there, before
# the shared ref moves.
refuse_duplicate_adr_ids() {
	[[ ${mode} == publish ]] || return 0
	local duplicates
	duplicates=$(git ls-tree --name-only HEAD docs/decisions/adr/ | sed -nE 's|^docs/decisions/adr/(ADR-[0-9]+)-.*|\1|p' | sort | uniq -d)
	[[ -z ${duplicates} ]] || refuse_publication "decision record id taken twice on the rebased tree: ${duplicates//$'\n'/, }; renumber yours to the next free id and retry"
}

# `main` and `dev` can advance between any two commands because every worktree
# shares the refs. Absorb both observed integration lines, then publish by
# fast-forwarding `dev` only if it still equals that observation. A failed
# compare-and-swap is contention, not permission to overwrite; observe the new
# tips and retry. This command never moves either shared ref except for the
# final compare-and-swap of `dev` in publish mode.
# The record ci/gates.sh attaches to a checked commit (docs/maintaining.md)
# follows the commit through every rewrite below.
evidence_ref=refs/notes/evidence

absorbed_main=
for attempt in {1..16}; do
	main_tip=$(git rev-parse refs/heads/main)
	if [[ ${absorbed_main} != "${main_tip}" ]]; then
		if ! git merge-base --is-ancestor "${main_tip}" HEAD; then
			echo "glowcap-integrate: rebasing ${branch} onto main ${main_tip}"
			git -c notes.rewriteRef="${evidence_ref}" rebase --no-update-refs "${main_tip}"
		fi
		absorbed_main=${main_tip}
	fi
	dev_tip=$(git rev-parse refs/heads/dev)
	if ! git merge-base --is-ancestor "${dev_tip}" HEAD; then
		echo "glowcap-integrate: rebasing ${branch} onto dev ${dev_tip}"
		git -c notes.rewriteRef="${evidence_ref}" rebase --no-update-refs "${dev_tip}"
		continue
	fi
	if [[ ${mode} == sync ]]; then
		if [[ $(git rev-parse refs/heads/main) == "${main_tip}" && $(git rev-parse refs/heads/dev) == "${dev_tip}" ]]; then
			echo "glowcap-integrate: ${branch} absorbed main ${main_tip} and contains dev ${dev_tip}; shared refs unchanged"
			exit 0
		fi
		echo "glowcap-integrate: a shared ref changed during sync; retrying (${attempt}/16)" >&2
		continue
	fi
	if [[ $(git rev-parse refs/heads/main) != "${main_tip}" ]]; then
		echo "glowcap-integrate: main changed during integration; retrying (${attempt}/16)" >&2
		continue
	fi
	# The worktree keeps its small commits as drafts. Dev takes one commit per
	# change, made and signed here: a single commit keeps its message, several
	# squash under one named by -m. The integrator's signature is what dev
	# holds, so a worktree commit needs none.
	# The branch's own commits are those neither dev nor main already holds;
	# main's commits that dev lacks ride below them and land unsquashed.
	head=$(git rev-parse HEAD)
	refuse_duplicate_adr_ids
	own=$(git rev-list --count --right-only --cherry-pick "${main_tip}...${head}" "^${dev_tip}")
	[[ ${own} -gt 0 ]] || refuse_publication "${branch} has no commits of its own beyond dev"
	# A merge contributes commits on both arms, but ~ walks only first parents.
	# Find the shared boundary on that same path instead of using the total.
	depth=$(git rev-list --first-parent --count "${head}" "^${main_tip}" "^${dev_tip}")
	base=$(git rev-parse "${head}~${depth}")
	git merge-base --is-ancestor "${dev_tip}" "${base}" ||
		refuse_publication "squash parent would replace existing dev history"
	if [[ $(git rev-list --count --right-only --cherry-pick "${main_tip}...${base}" "^${dev_tip}") -ne 0 ]]; then
		refuse_publication "${branch} interleaves its own commits with main's; rebase them on top and retry"
	fi
	if [[ ${own} -gt 1 ]]; then
		if [[ -z ${subject} ]]; then
			git log --reverse --format='  %s' "${base}..${head}" >&2
			refuse_publication "${own} commits since dev; name the squashed change with -m <subject>"
		fi
		message=$(
			printf '%s\n\n' "${subject}"
			git log --reverse --format='- %s' "${base}..${head}"
		)
	elif [[ -n ${subject} ]]; then
		refuse_publication "one commit publishes as written; drop -m"
	else
		message=$(git log -1 --format=%B "${head}")
	fi
	# The author field records who wrote the change and the signature who
	# vouched for it. One author across the branch's commits stays the author;
	# several fall to the integrator, whose message lists them.
	author_env=()
	authors=$(git log --format='%an%x09%ae' "${base}..${head}" | sort -u)
	if [[ $(printf '%s\n' "${authors}" | wc -l) -eq 1 ]]; then
		author_env=(
			"GIT_AUTHOR_NAME=${authors%%$'\t'*}"
			"GIT_AUTHOR_EMAIL=${authors##*$'\t'}"
			"GIT_AUTHOR_DATE=$(git log -1 --format=%aD "${head}")"
		)
	fi
	publish=$(env "${author_env[@]}" git commit-tree -S "${head}^{tree}" -p "${base}" -m "${message}") ||
		refuse_publication "dev takes only commits signed at integration; make the signing key reachable (forward the agent that holds it) and retry"
	git verify-commit "${publish}" 2>/dev/null ||
		refuse_publication "the signature on the integrated commit does not verify; name the key in gpg.ssh.allowedSignersFile and retry"
	require_unchecked_dev refuse_publication
	if git update-ref refs/heads/dev "${publish}" "${dev_tip}" 2>/dev/null; then
		# The signed commit has the branch's exact tree, so moving the branch
		# onto it leaves every file in place, and it keeps the branch's record.
		git reset -q --keep "${publish}"
		if git notes --ref="${evidence_ref}" show "${head}" >/dev/null 2>&1; then
			git notes --ref="${evidence_ref}" copy -f "${head}" "${publish}"
		fi
		echo "glowcap-integrate: merged ${branch} into dev at ${publish}"
		exit 0
	fi
	echo "glowcap-integrate: dev changed during integration; retrying (${attempt}/16)" >&2
done

die "shared refs kept changing after 16 attempts; leave the branch intact and retry later"
