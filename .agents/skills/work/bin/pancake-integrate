#!/usr/bin/env bash
set -euo pipefail

die() {
	echo "pancake-integrate: $*" >&2
	exit 1
}

usage="usage: pancake-integrate [--sync | -m <subject>]"
mode=publish
subject=
case ${1:-} in
	"") [[ $# -eq 0 ]] || die "${usage}" ;;
	--sync)
		[[ $# -eq 1 ]] || die "${usage}"
		mode=sync
		;;
	-m)
		[[ $# -eq 2 && -n ${2} ]] || die "${usage}"
		subject=$2
		;;
	*) die "${usage}" ;;
esac

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a Git worktree"
cd "${repo_root}"

branch_ref=$(git symbolic-ref --quiet HEAD) || die "detached HEAD has no worktree branch to integrate"
branch=${branch_ref#refs/heads/}
case "${branch}" in
	main | dev) die "run from the worktree's own branch, not ${branch}" ;;
esac

git show-ref --verify --quiet refs/heads/main || die "local main ref is missing"
git show-ref --verify --quiet refs/heads/dev || die "local dev ref is missing"

if [[ -n $(git status --porcelain --untracked-files=normal) ]]; then
	die "working tree is not clean; commit only your owned paths before integration"
fi

# `main` and `dev` can advance between any two commands because every worktree
# shares the refs. Absorb both observed integration lines, then publish by
# fast-forwarding `dev` only if it still equals that observation. A failed
# compare-and-swap is contention, not permission to overwrite; observe the new
# tips and retry. This command never moves either shared ref except for the
# final compare-and-swap of `dev` in publish mode.
absorbed_main=
for attempt in {1..16}; do
	main_tip=$(git rev-parse refs/heads/main)
	if [[ ${absorbed_main} != "${main_tip}" ]]; then
		if ! git merge-base --is-ancestor "${main_tip}" HEAD; then
			echo "pancake-integrate: rebasing ${branch} onto main ${main_tip}"
			git rebase --no-update-refs "${main_tip}"
		fi
		absorbed_main=${main_tip}
	fi
	dev_tip=$(git rev-parse refs/heads/dev)
	if ! git merge-base --is-ancestor "${dev_tip}" HEAD; then
		echo "pancake-integrate: rebasing ${branch} onto dev ${dev_tip}"
		git rebase --no-update-refs "${dev_tip}"
		continue
	fi
	if [[ ${mode} == sync ]]; then
		if [[ $(git rev-parse refs/heads/main) == "${main_tip}" && $(git rev-parse refs/heads/dev) == "${dev_tip}" ]]; then
			echo "pancake-integrate: ${branch} absorbed main ${main_tip} and contains dev ${dev_tip}; shared refs unchanged"
			exit 0
		fi
		echo "pancake-integrate: a shared ref changed during sync; retrying (${attempt}/16)" >&2
		continue
	fi
	if [[ $(git rev-parse refs/heads/main) != "${main_tip}" ]]; then
		echo "pancake-integrate: main changed during integration; retrying (${attempt}/16)" >&2
		continue
	fi
	# The worktree keeps its small commits. Dev takes one commit per change: a
	# single commit as written, several only as one squash named by -m.
	# The branch's own commits are those neither dev nor main already holds;
	# main's commits that dev lacks ride below them and land unsquashed.
	head=$(git rev-parse HEAD)
	own=$(git rev-list --count --right-only --cherry-pick "${main_tip}...${head}" "^${dev_tip}")
	[[ ${own} -gt 0 ]] || die "${branch} has no commits of its own beyond dev"
	base=$(git rev-parse "${head}~${own}")
	if [[ $(git rev-list --count --right-only --cherry-pick "${main_tip}...${base}" "^${dev_tip}") -ne 0 ]]; then
		die "${branch} interleaves its own commits with main's; rebase them on top and retry"
	fi
	publish=${head}
	if [[ ${own} -gt 1 ]]; then
		if [[ -z ${subject} ]]; then
			git log --reverse --format='  %s' "${base}..${head}" >&2
			die "${own} commits since dev; name the squashed change with -m <subject>"
		fi
		message=$(
			printf '%s\n\n' "${subject}"
			git log --reverse --format='- %s' "${base}..${head}"
		)
		publish=$(git commit-tree "${head}^{tree}" -p "${base}" -m "${message}")
	elif [[ -n ${subject} ]]; then
		die "one commit publishes as written; drop -m"
	fi
	if git update-ref refs/heads/dev "${publish}" "${dev_tip}" 2>/dev/null; then
		# The squash has the branch's exact tree, so moving the branch onto it
		# leaves every file in place.
		[[ ${publish} == "${head}" ]] || git reset -q --keep "${publish}"
		echo "pancake-integrate: merged ${branch} into dev at ${publish}"
		exit 0
	fi
	echo "pancake-integrate: dev changed during integration; retrying (${attempt}/16)" >&2
done

die "shared refs kept changing after 16 attempts; leave the branch intact and retry later"
