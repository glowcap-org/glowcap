{
  "license": "Apache-2.0",
  "imports": {
    "@glowcap/runtime/cleanup": "./bindings/ts/runtime/cleanup.ts",
    "@glowcap/runtime/text": "./bindings/ts/runtime/text.ts",
    "@glowcap/runtime": "./bindings/ts/runtime/mod.ts",
    "@glowcap/runtime/ffi": "./bindings/ts/runtime/ffi.ts",
    "@glowcap/runtime/adapter": "./bindings/ts/runtime/adapter.ts",
    "@glowcap/runtime/websocket": "./bindings/ts/runtime/websocket.ts",
    "@glowcap/runtime/transport": "./bindings/ts/runtime/transport.ts",
    "@glowcap/inproc": "./bindings/ts/inproc/mod.ts",
    "@glowcap/onion": "./bindings/ts/onion/mod.ts",
    "@glowcap/tcp": "./bindings/ts/tcp/mod.ts",
    "@glowcap/tcp/transport": "./bindings/ts/tcp/transport.ts",
    "@glowcap/iroh": "./bindings/ts/iroh/mod.ts",
    "@glowcap/iroh/internal": "./bindings/ts/iroh/internal.ts",
    "@glowcap/relay": "./bindings/ts/relay/mod.ts",
    "@glowcap/web": "./bindings/ts/web/mod.ts",
    "@glowcap/webrtc": "./bindings/ts/webrtc/mod.ts",
    "@glowcap/webrtc/driver": "./bindings/ts/webrtc/driver.ts",
    // dep playwright: Drives the browser tests.
    "playwright": "npm:playwright@1.65.0",
    // dep zod: Validates cross-application Rooms and ocapnviz trace proofs.
    "zod": "npm:zod@4.6.7",
    "zod/mini": "npm:zod@4.6.7/mini"
  },
  "lock": {
    "path": "./deno.lock",
    "frozen": true
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable"
    ]
  },
  "exclude": [
    "apps/ocapnviz",
    "apps/rooms"
  ],
  "fmt": {
    "lineWidth": 120,
    "semiColons": true,
    "singleQuote": false,
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.mjs"
    ],
    "exclude": [
      "bindings/ts",
      "zig-out",
      ".zig-cache",
      "**/target",
      "**/node_modules",
      "**/upstream",
      ".local",
      "**/*.yml",
      "**/*.yaml",
      "**/*.md",
      "**/*.json"
    ]
  }
}
