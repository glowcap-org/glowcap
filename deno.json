{
  "imports": {
    "@pancake/stack": "./bindings/ts/stack/mod.ts",
    "@pancake/stack/driver_loop": "./bindings/ts/stack/driver_loop.ts",
    "@pancake/stack/ffi": "./bindings/ts/stack/ffi.ts",
    "@pancake/iroh": "./bindings/ts/iroh/mod.ts",
    "@pancake/iroh/internal": "./bindings/ts/iroh/internal.ts",
    "@pancake/relay": "./bindings/ts/relay/mod.ts",
    "playwright": "npm:playwright@1.62.1",
    "react": "npm:react@19.2.8",
    "react/jsx-runtime": "npm:react@19.2.8/jsx-runtime",
    "react-dom": "npm:react-dom@19.2.8",
    "react-dom/client": "npm:react-dom@19.2.8/client",
    "@types/react": "npm:@types/react@19.2.18",
    "@types/react-dom": "npm:@types/react-dom@19.2.4",
    "zod": "npm:zod@^4.4.3"
  },
  // ocapnviz stays its own scope for everything else, but the rooms viz proofs
  // load its real converter and its real `Observation` schema at run time
  // instead of declaring a second copy of them, and both are built on zod. This
  // is the one specifier the root scope has to resolve for a proof to run the
  // viewer's own code. It is therefore one version with two homes, and
  // `zig build meta-check` (`checkSharedNpmPins`) is what keeps the two in step
  // rather than a reader remembering to.
  // The rooms browser page is the one TypeScript here that is JSX, and Deno reads
  // compilerOptions only from the root config of a scope, so its transform is
  // declared here rather than beside it in apps/rooms/web/ui/deno.json. It applies
  // to .tsx files alone, and this is the only directory that has any.
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "npm:@types/react@19.2.18"
  },
  // ocapnviz is its own Deno scope: its imports resolve through its own
  // deno.json, not this one, and its checks run through its own tasks. The
  // top-level exclude keeps every root-scope walk (check, lint, fmt) out.
  "exclude": ["apps/ocapnviz"],
  "fmt": {
    "useTabs": true,
    "indentWidth": 4,
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false,
    "include": ["**/*.ts", "**/*.tsx"],
    // yml/yaml/md/json are excluded so an explicit-path run (`deno fmt <dir>`)
    // cannot reach them: a path argument overrides `include`, and this formatter
    // would reindent YAML to four spaces, re-wrap Markdown to lineWidth, and
    // re-tab JSON, all against .editorconfig. Their formatting is owned by
    // .editorconfig and by hand.
    "exclude": ["bindings/ts", "zig-out", ".zig-cache", "**/target", "**/node_modules", "**/upstream", ".local", "**/*.yml", "**/*.yaml", "**/*.md", "**/*.json"]
  }
}
