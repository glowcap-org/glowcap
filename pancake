#!/usr/bin/env bash
# Repo-root shim → zig-out/bin/pancake (ADR-0084). Requires `zig build` first.
# Symlink-safe (the devcontainer links it onto PATH), so the repo root comes
# from the resolved script path, and the fallback build runs there too. The
# loop uses plain `readlink`; macOS does not provide GNU `readlink -f`.
set -euo pipefail
PANCAKE_SHIM="${BASH_SOURCE[0]}"
while [[ -L "${PANCAKE_SHIM}" ]]; do
	PANCAKE_SHIM_DIR="$(cd "$(dirname "${PANCAKE_SHIM}")" && pwd)"
	PANCAKE_SHIM_TARGET="$(readlink "${PANCAKE_SHIM}")"
	if [[ "${PANCAKE_SHIM_TARGET}" = /* ]]; then
		PANCAKE_SHIM="${PANCAKE_SHIM_TARGET}"
	else
		PANCAKE_SHIM="${PANCAKE_SHIM_DIR}/${PANCAKE_SHIM_TARGET}"
	fi
done
ROOT="$(cd "$(dirname "${PANCAKE_SHIM}")" && pwd)"
BIN="${PANCAKE_BIN:-$ROOT/zig-out/bin/pancake}"
if [[ ! -x "$BIN" ]]; then
	(cd "$ROOT" && zig build)
	if [[ ! -x "$BIN" ]]; then
		echo "pancake: missing executable at ${BIN} — run \`zig build\` from the repo root" >&2
		exit 1
	fi
fi
exec "$BIN" "$@"
