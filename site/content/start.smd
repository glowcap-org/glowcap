<!-- site-examples:dial:zig GENERATED by `zig build gen-site-examples`; edits are overwritten -->
```
> []($block.attrs('code-tabs'))
> **iroh**
> ```zig
> const std = @import("std");
> const glowcap = @import("glowcap");
> const iroh = @import("iroh");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator, partner_uri: []const u8) !void {
>     const partner = try glowcap.ocapn.model.uri.parsePeer(allocator, partner_uri);
>     defer glowcap.ocapn.model.freePeerLocator(allocator, partner);
>     var endpoint = try iroh.Resident.init(io, null, .{ .reachability = .discovery });
>     defer endpoint.deinit() catch |err| std.log.err("iroh endpoint: {s}", .{@errorName(err)});
>     var adapter = try iroh.MultiplexedAdapter.init(allocator, &endpoint);
>     defer if (adapter.deinit()) |failure| std.log.err("iroh adapter: {s}", .{failure.primaryName()});
>     const residents = [_]glowcap.driver.HostRuntime.ProviderRegistration{
>         .{ .profile = iroh.transport_profile, .resident = adapter.multiplexed() },
>     };
>
>     const session = try glowcap.driver.connect(
>         allocator,
>         io,
>         .{ .residents = &residents },
>         partner,
>         .ephemeral,
>         .{ .handshake = .{ .ms = 10_000 }, .settle = .{ .ms = 10_000 } },
>     );
> ```
> **webrtc**
> ```zig
> const std = @import("std");
> const glowcap = @import("glowcap");
> const webrtc = @import("webrtc");
>
> // `signaling` carries the offer and each candidate to the peer the locator
> // names, over a path you already hold, such as an OCapN capability both peers
> // can reach. The answer comes back through `Backend.provideAnswer`.
> pub fn example(io: std.Io, allocator: std.mem.Allocator, partner_uri: []const u8, signaling: webrtc.SignalingAuthority) !void {
>     const partner = try glowcap.ocapn.model.uri.parsePeer(allocator, partner_uri);
>     defer glowcap.ocapn.model.freePeerLocator(allocator, partner);
>     var endpoint = try webrtc.Resident.init(.{});
>     defer endpoint.deinit() catch |err| std.log.err("webrtc endpoint: {s}", .{@errorName(err)});
>     var resident = try webrtc.CompletionResident.init(
>         allocator,
>         try webrtc.Backend.initBound(allocator, &endpoint, signaling, 256, 16 * 1024),
>         .{},
>     );
>     defer resident.deinit();
>     const residents = [_]glowcap.driver.HostRuntime.ProviderRegistration{
>         .{ .profile = webrtc.transport_profile, .resident = resident.resident() },
>     };
>
>     const session = try glowcap.driver.connect(
>         allocator,
>         io,
>         .{ .residents = &residents },
>         partner,
>         .ephemeral,
>         .{ .handshake = .{ .ms = 10_000 }, .settle = .{ .ms = 10_000 } },
>     );
> ```
> **noise-tcp**
> ```zig
> const std = @import("std");
> const glowcap = @import("glowcap");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator) !void {
>     // Same TCP sockets as cleartext keyed dialing; Noise_XK seals the CapTP stream.
>     // The designator is the peer's durable key; the hint is where to dial.
>     var hint_storage: [1]glowcap.ocapn.model.HintEntry = undefined;
>     const peer_key = "<64 lowercase hex characters from the server>";
>     const partner = glowcap.net.tcp.noise.locator(
>         peer_key,
>         "127.0.0.1:9099",
>         &hint_storage,
>     );
>
>     const session = try glowcap.driver.connect(
>         allocator,
>         io,
>         .{ .symbols = &.{.noise_tcp} },
>         partner,
>         .ephemeral,
>         .{ .handshake = .{ .ms = 10_000 }, .settle = .{ .ms = 10_000 } },
>     );
> ```
> **noise-relay**
> ```zig
> const std = @import("std");
> const glowcap = @import("glowcap");
> const relay_tls = @import("relay_tls");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator) !void {
>     // Noise_XK seals the session end to end; the relay forwards ciphertext.
>     const relay_url = "wss://relay.example/relay";
>     var tls = switch (relay_tls.initTlsOwner(io, allocator, .system)) {
>         .ready => |ready| ready.owner,
>         .failed => return error.RelayUnavailable,
>     };
>     defer switch (tls.release()) {
>         .released => {},
>         .busy, .failed => std.log.err("relay TLS teardown failed", .{}),
>     };
>     var entropy: [std.Random.DefaultCsprng.secret_seed_length]u8 = undefined;
>     try io.randomSecure(&entropy);
>     const transports: glowcap.driver.Transports = .{ .symbols = &.{.noise_relay}, .relay = .{
>         .url = relay_url,
>         .entropy_seed = entropy,
>         .resolver_io = io,
>         .tls_owner = tls,
>     } };
>     var hint_storage: [1]glowcap.ocapn.model.HintEntry = undefined;
>     const peer_key = "<64 lowercase hex characters from the server>";
>     const partner = glowcap.net.relay.noise.locator(peer_key, relay_url, &hint_storage);
>     const session = try glowcap.driver.connect(
>         allocator,
>         io,
>         transports,
>         partner,
>         .ephemeral,
>         .{ .handshake = .{ .ms = 10_000 }, .settle = .{ .ms = 10_000 } },
>     );
> ```
