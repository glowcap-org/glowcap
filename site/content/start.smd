> **inproc**
> ```zig
> const std = @import("std");
> const glowcap = @import("glowcap");
>
> pub fn example(
>     io: std.Io,
>     allocator: std.mem.Allocator,
>     exchange: *glowcap.net.inproc_completion.Exchange,
> ) !void {
>     // The listening peer and dialer share this process-local switchboard.
>     const partner = glowcap.net.inproc.locator("greeter");
>     const session = try glowcap.driver.connect(
>         allocator,
>         io,
>         .{ .symbols = &.{.inproc}, .inproc = exchange },
>         partner,
>         .ephemeral,
>         .{ .handshake = .{ .ms = 10_000 }, .settle = .{ .ms = 10_000 } },
>     );
> ```

From here, the CapTP workflow is the same for every transport:

```zig
    defer session.deinit();

    const greeter = try session.fetch("greeter"); // a capability this peer published
    var arena = std.heap.ArenaAllocator.init(allocator);
    defer arena.deinit();
    const settled = try session.call(greeter, "greet", &.{.{ .string = "world" }}, arena.allocator());
    switch (settled) {
        .fulfilled => |value| std.debug.print("{s}\n", .{value.string}),
        .broken => |reason| std.debug.print("the greeter refused: {s}\n", .{reason}),
    }
}
```
```=html
<!-- /site-examples:dial:zig -->
```

The snippets take `io` and an allocator. Create `io` from `std.Io.Threaded`
before calling them:

```zig
var threaded = std.Io.Threaded.init(allocator, .{});
const io = threaded.io();
```

A locator says which peer to reach. On the `tcp` path it is a `host:port`
such as `"127.0.0.1:9099"`. On `keyed-tcp` (cleartext) and `noise-tcp` it
names the peer by its durable public key, and the address to dial goes in a
`direct-addresses` hint. The relay tabs put the relay's URL in the hint
instead. `noise-tcp` uses the same sockets as `keyed-tcp` and seals the stream
with Noise_XK. The [Noise guide]($link.page('transports/noise')) explains when
to choose Noise over iroh, and how `noise-relay` seals a path through a relay.

`handshake` limits each read while the connection opens, and `settle` limits
each wait for an answer after that. `.ephemeral` is
a throwaway keypair made for this one connection. The arena owns the memory for
replies, and freeing it frees them. Chapter 01 on the
[Examples]($link.page('examples')) page is this same fetch-and-call as a
complete program.

# Listen

Each tab is the other side of the matching Dial tab. It binds an address,
publishes a greeter, accepts connections, and serves them.

On keyed and Noise TCP, `designator` is the address the listener binds, and
the durable key goes into the locator it publishes. On iroh, relay, and onion
the designator is empty, and the transport fills in the locator it
advertises. On `inproc` it is the name dialers look up.

```=html
<!-- site-examples:listen:zig GENERATED by `zig build gen-site-examples`; edits are overwritten -->
```
> []($block.attrs('code-tabs'))
> **iroh**
> ```zig
> const std = @import("std");
> const glowcap = @import("glowcap");
> const iroh = @import("iroh");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator) !void {
>     var seed: [32]u8 = undefined;
>     try io.randomSecure(&seed); // retain this seed to restore the node identity
>     const secret = glowcap.foundation.crypto.SecretKey.fromSeed(seed);
>     var endpoint = try iroh.Resident.init(io, &seed, .{ .reachability = .discovery });
>     defer endpoint.deinit() catch |err| std.log.err("iroh endpoint: {s}", .{@errorName(err)});
>     var adapter = try iroh.MultiplexedAdapter.init(allocator, &endpoint);
>     defer if (adapter.deinit()) |failure| std.log.err("iroh adapter: {s}", .{failure.primaryName()});
>     const residents = [_]glowcap.driver.HostRuntime.ProviderRegistration{
>         .{ .profile = iroh.transport_profile, .resident = adapter.multiplexed() },
>     };
>     const server = try glowcap.driver.listen(
>         allocator,
>         io,
>         .{ .residents = &residents },
>         iroh.transport_name,
>         .{ .designator = "" },
>         .{ .keyed = secret },
>         .{ .handshake = .{ .ms = 10_000 }, .settle = .{ .ms = 10_000 } },
>     );
>     defer server.deinit();
>
>     const uri = try glowcap.ocapn.model.uri.writePeer(allocator, (try server.advertisedLocator()));
>     defer allocator.free(uri);
>     std.debug.print("{s}\n", .{uri}); // hand this locator to partners
>
>     try serve(server);
> }
> ```
> **noise-tcp**
> ```zig
> const std = @import("std");
> const glowcap = @import("glowcap");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator) !void {
>     const seed = @as([32]u8, @splat(7)); // load durable secret bytes in a real service
>     const secret = glowcap.foundation.crypto.SecretKey.fromSeed(seed);
>     const server = try glowcap.driver.listen(
>         allocator,
>         io,
>         .{ .symbols = &.{.noise_tcp} },
>         glowcap.ocapn.model.transport.noise_tcp,
>         .{ .designator = "127.0.0.1:9099" },
>         .{ .keyed = secret },
>         .{ .handshake = .{ .ms = 10_000 }, .settle = .{ .ms = 10_000 } },
>     );
>     defer server.deinit();
>
>     const uri = try glowcap.ocapn.model.uri.writePeer(allocator, (try server.advertisedLocator()));
>     defer allocator.free(uri);
>     std.debug.print("{s}\n", .{uri}); // Noise proves this durable key to dialers
>
>     try serve(server);
> }
> ```
> **noise-relay**
> ```zig
> const std = @import("std");
> const glowcap = @import("glowcap");
> const relay_tls = @import("relay_tls");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator) !void {
>     // Register this key at the relay; Noise_XK seals every accepted CapTP stream.
>     const seed = @as([32]u8, @splat(7)); // load durable secret bytes in a real service
>     const secret = glowcap.foundation.crypto.SecretKey.fromSeed(seed);
>     var tls = switch (relay_tls.initTlsOwner(io, allocator, .system)) {
>         .ready => |ready| ready.owner,
>         .failed => return error.RelayUnavailable,
>     };
>     defer switch (tls.release()) {
>         .released => {},
>         .busy, .failed => std.log.err("relay TLS teardown failed", .{}),
>     };
>     var entropy: [std.Random.DefaultCsprng.secret_seed_length]u8 = undefined;
>     try io.randomSecure(&entropy);
>     const server = try glowcap.driver.listen(
>         allocator,
>         io,
>         .{ .symbols = &.{.noise_relay}, .relay = .{
>             .url = "wss://relay.example/relay",
>             .entropy_seed = entropy,
>             .resolver_io = io,
>             .tls_owner = tls,
>             .registration = .{ .url = "wss://relay.example/register" },
>         } },
>         glowcap.ocapn.model.transport.noise_relay,
>         .{ .designator = "" },
>         .{ .keyed = secret },
>         .{ .handshake = .{ .ms = 10_000 }, .settle = .{ .ms = 10_000 } },
>     );
>     defer server.deinit();
>
>     const uri = try glowcap.ocapn.model.uri.writePeer(allocator, (try server.advertisedLocator()));
>     defer allocator.free(uri);
>     std.debug.print("{s}\n", .{uri}); // Noise seals the relay path end to end
>
>     try serve(server);
> }
> ```
> **onion**
> ```zig
> const std = @import("std");
> const glowcap = @import("glowcap");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator) !void {
>     // glowcap starts no Tor. Name an already-running daemon's SOCKS and control ports.
>     const server = try glowcap.driver.listen(
>         allocator,
>         io,
>         .{ .symbols = &.{.onion}, .onion = .{
>             .socks = try glowcap.net.tcp.parseDesignator("127.0.0.1:9050"),
>             .control = try glowcap.net.tcp.parseDesignator("127.0.0.1:9051"),
>         } },
>         glowcap.ocapn.model.transport.onion,
>         .{ .designator = "" },
>         .ephemeral,
>         .{ .handshake = .{ .ms = 10_000 }, .settle = .{ .ms = 10_000 } },
>     );
>     defer server.deinit();
>
>     const uri = try glowcap.ocapn.model.uri.writePeer(allocator, (try server.advertisedLocator()));
>     defer allocator.free(uri);
>     std.debug.print("{s}\n", .{uri}); // hand this locator to partners
>
>     var service_key_storage: [256]u8 = undefined;
>     const key_len = (try server.restorationState(&service_key_storage)) orelse
>         return error.RestorationStateUnavailable;
>     const service_key = service_key_storage[0..key_len];
>     _ = service_key; // persist securely to restore this service
>
>     try serve(server);
> }
> ```
