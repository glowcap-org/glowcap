> **inproc**
> ```zig
> const std = @import("std");
> const glowcap = @import("glowcap");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator) !void {
>     var exchange = glowcap.net.inproc_completion.Exchange.init(allocator);
>     defer exchange.deinit();
>     const server = try glowcap.driver.listen(
>         allocator,
>         io,
>         .{ .symbols = &.{.inproc}, .inproc = &exchange },
>         glowcap.ocapn.model.transport.inproc,
>         .{ .designator = "greeter" },
>         .ephemeral,
>         .{ .handshake = .{ .ms = 10_000 }, .settle = .{ .ms = 10_000 } },
>     );
>     defer server.deinit();
>
>     try serve(server);
> }
> ```

From here, the CapTP workflow is the same for every transport:

```zig
const Greeter = struct {
    pub fn handle(_: *Greeter, ht: *glowcap.driver.HostTurn, selector: ?[]const u8, args: glowcap.driver.Args) !glowcap.driver.Value {
        defer ht.releaseArguments(args);
        const verb = selector orelse return error.NoSuchMethod;
        if (!std.mem.eql(u8, verb, "greet")) return error.NoSuchMethod;
        if ((try args.len()) != 1) return error.BadInvocation;
        return .{ .string = try std.fmt.allocPrint(ht.turn.arena, "Hello, {s}", .{try args.string(0)}) };
    }
};

fn serve(server: *glowcap.driver.Server) !void {
    try server.publish("greeter", Greeter, .{});
    while (true) {
        var session = try server.accept();
        defer session.deinit();
        try session.serve();
    }
}
```
```=html
<!-- /site-examples:listen:zig -->
```

The tabs show the transport setup and the shared call or serving code.
For a runnable program with both peers and their lifetimes in place, use
[the first example](https://github.com/glowcap-org/glowcap/blob/main/examples/zig/01_connect_and_serve.zig).
To try CapTP from a shell instead, see the [CapTP CLI]($link.page('cli')).

# [Add other transports]($section.id('add-other-transports'))

The iroh, relay, and WebRTC tabs import modules that link outside code.
Add `.iroh = true` or `.webrtc = true` to the dependency options when using
that transport, then add its import:

```zig
// iroh: links a Rust library, so the build needs cargo on PATH.
exe.root_module.addImport("iroh", glowcap.module("glowcap_iroh"));
// noise-relay and keyed-relay: builds Mbed TLS from source.
exe.root_module.addImport("relay_tls", glowcap.module("glowcap_relay_tls"));
// webrtc: links a Rust library, so the build needs cargo on PATH.
exe.root_module.addImport("webrtc", glowcap.module("glowcap_webrtc"));
```

If capabilities, locators, pipelining, or three-party handoff are new to you,
read [Concepts]($link.page('concepts')) next.
