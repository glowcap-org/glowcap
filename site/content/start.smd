Choose the API for your language. The Zig walkthrough builds one complete
CapTP call; the C ABI and language bindings provide the same operations with
their own ownership and concurrency conventions.

- <a href="#in-zig">Zig</a>
- <a href="#from-c-or-any-ffi-host">C or another FFI host</a>
- [Rust]($link.page('bindings/rust'))
- [TypeScript]($link.page('bindings/ts'))
- [Python]($link.page('bindings/python'))
- [Racket]($link.page('bindings/racket'))
- [Browser WebAssembly]($link.page('bindings/browser'))

Pin a commit when you add pancake to a project. The public API can still
change.

# In Zig

pancake is a [Zig](https://ziglang.org/) package. Add a pinned checkout to
your build:

```sh
zig fetch --save git+https://github.com/jimisaacs/pancake#COMMIT_SHA
```

Replace `COMMIT_SHA` with the revision you want to pin.

```zig
const pancake = b.dependency("pancake", .{ .target = target, .optimize = optimize });
exe.root_module.addImport("pancake", pancake.module("pancake"));
```

The `pancake` module is pure Zig. Two of the tabs below import a transport
module of their own, and each brings its native dependency with it:

```zig
// iroh: links the Rust sidecar, so the build needs cargo on PATH.
exe.root_module.addImport("iroh", pancake.module("pancake_iroh"));
// noise-relay and keyed-relay: builds Mbed TLS from source.
exe.root_module.addImport("native_relay", pancake.module("pancake_native_relay"));
```

# Dial

The first tab is **iroh**: encrypted QUIC, the peer's node id is the identity.
`noise-tcp` is the sealed TCP path for two pancake peers that already share a
route. Plain `tcp` is cleartext and for local tests only. For a deployment, pick a row from
[Choosing a transport]($link.page('transports/choosing')) and switch tabs.

```=html
<!-- site-examples:dial:zig GENERATED by `zig build gen-site-examples`; edits are overwritten -->
```
> []($block.attrs('code-tabs'))
> **iroh**
> ```zig
> const std = @import("std");
> const pancake = @import("pancake");
> const iroh = @import("iroh");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator) !void {
>     // Discovery resolves a bare iroh node ID without an address hint.
>     var iroh_resident = try iroh.Resident.init(io, null, .{ .reachability = .discovery });
>     defer iroh_resident.deinit() catch |err| std.log.err("iroh teardown failed: {s}", .{@errorName(err)});
>     const netlayers = [_]pancake.net.netlayer.Netlayer{iroh_resident.netlayer()};
>     const node_id = "<64 lowercase hex characters from the server>";
>     const partner = iroh.locator(node_id);
> ```
> **noise-tcp**
> ```zig
> const std = @import("std");
> const pancake = @import("pancake");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator) !void {
>     // Same TCP sockets as cleartext keyed dialing; Noise_XK seals the CapTP stream.
>     var noise_resident = pancake.net.tcp.noise.Resident{ .io = io };
>     const netlayers = [_]pancake.net.netlayer.Netlayer{noise_resident.netlayer()};
>     // The designator is the peer's durable key; the hint is where to dial.
>     var hint_storage: [1]pancake.ocapn.model.HintEntry = undefined;
>     const peer_key = "<64 lowercase hex characters from the server>";
>     const partner = pancake.net.tcp.noise.locator(
>         peer_key,
>         "127.0.0.1:9099",
>         &hint_storage,
>     );
> ```
> **noise-relay**
> ```zig
> const std = @import("std");
> const pancake = @import("pancake");
> const native_relay = @import("native_relay");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator) !void {
>     // Noise_XK seals the session end to end; the relay forwards ciphertext.
>     const relay_url = "wss://relay.example/relay";
>     var relay: native_relay.Provider = undefined;
>     switch (relay.init(io, allocator, relay_url, null, .system)) {
>         .ready => {},
>         .failed => return error.RelayUnavailable,
>     }
>     defer if (relay.deinit()) |chain| std.log.err("relay teardown failed: {s}", .{chain.primaryName()});
>     const netlayers = [_]pancake.net.netlayer.Netlayer{relay.resident(.noise).netlayer()};
>     var hint_storage: [1]pancake.ocapn.model.HintEntry = undefined;
>     const peer_key = "<64 lowercase hex characters from the server>";
>     const partner = pancake.net.relay.noise.locator(peer_key, relay_url, &hint_storage);
> ```
> **onion**
> ```zig
> const std = @import("std");
> const pancake = @import("pancake");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator) !void {
>     // Dial through the same SOCKS endpoint the listener named.
>     var onion_resident = pancake.net.onion.Resident{ .io = io, .config = .{
>         .socks = "/run/tor/socks",
>     } };
>     const netlayers = [_]pancake.net.netlayer.Netlayer{onion_resident.netlayer()};
>     const partner = pancake.net.onion.locator("<56-character onion service id>");
> ```
> **keyed-tcp**
> ```zig
> const std = @import("std");
> const pancake = @import("pancake");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator) !void {
>     // Key designator, cleartext CapTP. Reuse a seed across restarts to keep the same key.
>     var keyed_resident = pancake.net.tcp.keyed.Resident{ .io = io };
>     const netlayers = [_]pancake.net.netlayer.Netlayer{keyed_resident.netlayer()};
>     var hint_storage: [1]pancake.ocapn.model.HintEntry = undefined;
>     const peer_key = "<64 lowercase hex characters from the server>";
>     const partner = pancake.net.tcp.keyed.locator(
>         peer_key,
>         "127.0.0.1:9099",
>         &hint_storage,
>     );
> ```
> **keyed-relay**
> ```zig
> const std = @import("std");
> const pancake = @import("pancake");
> const native_relay = @import("native_relay");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator) !void {
>     // The key names the peer; the hint names the relay that can reach it.
>     const relay_url = "wss://relay.example/relay";
>     var relay: native_relay.Provider = undefined;
>     switch (relay.init(io, allocator, relay_url, null, .system)) {
>         .ready => {},
>         .failed => return error.RelayUnavailable,
>     }
>     defer if (relay.deinit()) |chain| std.log.err("relay teardown failed: {s}", .{chain.primaryName()});
>     const netlayers = [_]pancake.net.netlayer.Netlayer{relay.resident(.keyed).netlayer()};
>     var hint_storage: [1]pancake.ocapn.model.HintEntry = undefined;
>     const peer_key = "<64 lowercase hex characters from the server>";
>     const partner = pancake.net.relay.keyed.locator(peer_key, relay_url, &hint_storage);
> ```
> **tcp**
> ```zig
> const std = @import("std");
> const pancake = @import("pancake");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator) !void {
>     // Plain TCP uses a cleartext `host:port` locator.
>     var tcp_resident = pancake.net.tcp.Resident{ .io = io };
>     const netlayers = [_]pancake.net.netlayer.Netlayer{tcp_resident.netlayer()};
>     const partner = pancake.net.tcp.locator("127.0.0.1:9099");
> ```
> **inproc**
> ```zig
> const std = @import("std");
> const pancake = @import("pancake");
>
> pub fn example(
>     allocator: std.mem.Allocator,
>     network: *pancake.net.inproc.Network,
> ) !void {
>     // The listening peer and dialer share this process-local switchboard.
>     const netlayers = [_]pancake.net.netlayer.Netlayer{network.netlayer()};
>     const partner = pancake.net.inproc.locator("greeter");
> ```

From here, the CapTP workflow is the same for every transport:

```zig
    const session = try pancake.driver.connect(
        allocator,
        &netlayers,
        partner,
        .ephemeral,
        .{ .handshake = .{ .ms = 10_000 }, .settle = .{ .ms = 10_000 } },
    );
    defer session.deinit();

    const greeter = try session.fetch("greeter"); // a capability this peer published
    var arena = std.heap.ArenaAllocator.init(allocator);
    defer arena.deinit();
    const settled = try session.call(greeter, "greet", &.{.{ .string = "world" }}, arena.allocator());
    switch (settled) {
        .fulfilled => |value| std.debug.print("{s}\n", .{value.string}),
        .broken => |reason| std.debug.print("the greeter refused: {s}\n", .{reason}),
    }
}
```
```=html
<!-- /site-examples:dial:zig -->
```

The snippets take `io` and an allocator. Create `io` from `std.Io.Threaded`
before calling them:

```zig
var threaded = std.Io.Threaded.init(allocator, .{});
const io = threaded.io();
```

The iroh tab uses a node-id locator; the [iroh guide]($link.page('transports/iroh'))
covers discovery and deployment. `noise-tcp` seals the same sockets as
`keyed-tcp` with Noise_XK. The [Noise guide]($link.page('transports/noise'))
covers when to pick Noise over iroh and how `noise-relay` seals the relay path.
On the `tcp` path the locator is a `host:port` such as `"127.0.0.1:9099"`.
On the keyed and sealed TCP paths the designator is the peer's durable key,
and the bound address rides in the `direct-addresses` hint instead. The two
timeout values keep network waits finite.

`.ephemeral` is the session identity, a throwaway keypair minted for this
connection. The arena owns reply allocations; dropping it frees them.

See the complete client and server in
[`01_connect_and_serve.zig`](https://github.com/jimisaacs/pancake/blob/main/examples/zig/01_connect_and_serve.zig),
the numbered walk over a local TCP socket.

# Listen

The first tab is **iroh**, matching Dial. Each tab is the listen half of the
dial example above: bind, publish a greeter, accept, and serve.

On keyed and sealed TCP, `designator` is the address the listener binds; the
durable key rides in the published locator. On iroh and onion the designator is
empty and the transport fills the advertised locator.

```=html
<!-- site-examples:listen:zig GENERATED by `zig build gen-site-examples`; edits are overwritten -->
```
> []($block.attrs('code-tabs'))
> **iroh**
> ```zig
> const std = @import("std");
> const pancake = @import("pancake");
> const iroh = @import("iroh");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator) !void {
>     const seed = @as([32]u8, @splat(7)); // keep this seed to preserve the node id
>     const secret = pancake.foundation.crypto.SecretKey.fromSeed(seed);
>     var iroh_resident = try iroh.Resident.init(io, &seed, .{ .reachability = .discovery });
>     defer iroh_resident.deinit() catch |err| std.log.err("iroh teardown failed: {s}", .{@errorName(err)});
>     const server = try pancake.driver.listen(
>         allocator,
>         iroh_resident.netlayer(),
>         .{ .designator = "" },
>         .{ .keyed = secret },
>         .{ .handshake = .{ .ms = 10_000 }, .settle = .{ .ms = 10_000 } },
>     );
>     defer server.deinit();
>
>     const uri = try pancake.ocapn.model.uri.writePeer(allocator, (try server.advertisedLocator()));
>     defer allocator.free(uri);
>     std.debug.print("{s}\n", .{uri}); // hand this discovery-reachable node id to partners
>
>     try serve(server);
> }
> ```
> **noise-tcp**
> ```zig
> const std = @import("std");
> const pancake = @import("pancake");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator) !void {
>     const seed = @as([32]u8, @splat(7)); // load durable secret bytes in a real service
>     const secret = pancake.foundation.crypto.SecretKey.fromSeed(seed);
>     var noise_resident = pancake.net.tcp.noise.Resident{ .io = io };
>     const server = try pancake.driver.listen(
>         allocator,
>         noise_resident.netlayer(),
>         .{ .designator = "127.0.0.1:9099" },
>         .{ .keyed = secret },
>         .{ .handshake = .{ .ms = 10_000 }, .settle = .{ .ms = 10_000 } },
>     );
>     defer server.deinit();
>
>     const uri = try pancake.ocapn.model.uri.writePeer(allocator, (try server.advertisedLocator()));
>     defer allocator.free(uri);
>     std.debug.print("{s}\n", .{uri}); // Noise proves this durable key to dialers
>
>     try serve(server);
> }
> ```
> **noise-relay**
> ```zig
> const std = @import("std");
> const pancake = @import("pancake");
> const native_relay = @import("native_relay");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator) !void {
>     // Register this key at the relay; Noise_XK seals every accepted CapTP stream.
>     const seed = @as([32]u8, @splat(7)); // load durable secret bytes in a real service
>     const secret = pancake.foundation.crypto.SecretKey.fromSeed(seed);
>     var relay: native_relay.Provider = undefined;
>     switch (relay.init(
>         io,
>         allocator,
>         "wss://relay.example/relay",
>         "wss://relay.example/register",
>         .system,
>     )) {
>         .ready => {},
>         .failed => return error.RelayUnavailable,
>     }
>     defer if (relay.deinit()) |chain| std.log.err("relay teardown failed: {s}", .{chain.primaryName()});
>     const server = try pancake.driver.listen(
>         allocator,
>         relay.resident(.noise).netlayer(),
>         .{ .designator = "" },
>         .{ .keyed = secret },
>         .{ .handshake = .{ .ms = 10_000 }, .settle = .{ .ms = 10_000 } },
>     );
>     defer server.deinit();
>
>     const uri = try pancake.ocapn.model.uri.writePeer(allocator, (try server.advertisedLocator()));
>     defer allocator.free(uri);
>     std.debug.print("{s}\n", .{uri}); // Noise seals the relay path end to end
>
>     try serve(server);
> }
> ```
> **onion**
> ```zig
> const std = @import("std");
> const pancake = @import("pancake");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator) !void {
>     // pancake starts no Tor. Name an already-running daemon's SOCKS and control endpoints.
>     var onion_resident = pancake.net.onion.Resident{ .io = io, .config = .{
>         .socks = "/run/tor/socks",
>         .control_endpoint = "/run/tor/control",
>     } };
>     const server = try pancake.driver.listen(
>         allocator,
>         onion_resident.netlayer(),
>         .{ .designator = "" },
>         .ephemeral,
>         .{ .handshake = .{ .ms = 10_000 }, .settle = .{ .ms = 10_000 } },
>     );
>     defer server.deinit();
>
>     const uri = try pancake.ocapn.model.uri.writePeer(allocator, (try server.advertisedLocator()));
>     defer allocator.free(uri);
>     std.debug.print("{s}\n", .{uri}); // hand this locator to partners
>
>     var service_key_storage: [256]u8 = undefined;
>     const key_len = (try server.restorationState(&service_key_storage)) orelse
>         return error.RestorationStateUnavailable;
>     const service_key = service_key_storage[0..key_len];
>     _ = service_key; // persist securely to restore this service
>
>     try serve(server);
> }
> ```
