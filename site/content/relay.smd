## Noise

> []($block.attrs('code-tabs'))
> **Zig**
> ```zig
> const std = @import("std");
> const pancake = @import("pancake");
> const native_relay = @import("native_relay");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator) !void {
>     // Noise_XK seals the session end to end; the relay forwards ciphertext.
>     const relay_url = "wss://relay.example/relay";
>     var relay: native_relay.Provider = undefined;
>     switch (relay.init(io, allocator, relay_url, null, .system)) {
>         .ready => {},
>         .failed => return error.RelayUnavailable,
>     }
>     defer if (relay.deinit()) |chain| std.log.err("relay teardown failed: {s}", .{chain.primaryName()});
>     const netlayers = [_]pancake.net.netlayer.Netlayer{relay.resident(.noise).netlayer()};
>     var hint_storage: [1]pancake.ocapn.model.HintEntry = undefined;
>     const peer_key = "<64 lowercase hex characters from the server>";
>     const partner = pancake.net.relay.noise.locator(peer_key, relay_url, &hint_storage);
> ```
> **TypeScript**
> ```ts
> import { Runtime } from "@pancake/runtime";
> import { noise, provider } from "@pancake/relay";
>
> // Noise_XK seals the session end to end; the relay forwards ciphertext.
> const peerKey = "<64 lowercase hex characters from the server>";
> const relayUrl = "wss://relay.example/relay";
> const partner = noise.locator(peerKey, relayUrl);
>
> await using runtime = await Runtime.open({
> 	providers: [provider({ relayUrl })],
> });
> ```
> **Browser**
> ```ts
> import { connector, noise } from "@pancake/relay";
> import { init } from "@pancake/web";
>
> const relayUrl = "wss://relay.example/relay";
> const web = await init({
> 	wasm: fetch("/pancake_host.wasm"),
> 	connectors: [connector()],
> });
> await using runtime = web.runtime;
> const partner = noise.locator("<64 lowercase hex characters>", relayUrl);
> ```
> **Python**
> ```python
> from pancake import Runtime, relay
>
> # Noise_XK seals the CapTP stream end to end through the relay.
> peer_key = "<64 lowercase hex characters from the server>"
> relay_url = "wss://relay.example/relay"
> partner = relay.noise.locator(peer_key, relay_url)
>
> async with Runtime.open(provider=relay.provider(relay_url)) as runtime:
> ```
> **Rust**
> ```rust
> use pancake::{relay, Argument, ConnectOptions, PendingWork, Runtime, RuntimeConfig};
>
> // Noise_XK seals the CapTP stream end to end through the relay.
> let peer_key = "<64 lowercase hex characters from the server>";
> let relay_url = "wss://relay.example/relay";
> let partner = relay::noise::locator(peer_key, relay_url);
> let runtime = Runtime::open(RuntimeConfig::providers([relay::provider(
> 	relay::Config::dial_only(relay_url),
> )]))
> .await?;
> ```
> **Racket**
> ```scheme
> (require "pancake.rkt" "pancake-relay.rkt")
>
> ;; Noise_XK seals the CapTP stream end to end through the relay.
> (define peer-key "<64 lowercase hex characters from the server>")
> (define relay-url "wss://relay.example/relay")
> (define partner (noise-relay-locator peer-key relay-url))
> (define runtime
>   (open-runtime #:providers (list (relay-provider #:relay-url relay-url))))
> ```

