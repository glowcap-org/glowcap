# Listen

A listening peer registers its durable key with the relay and keeps the
registration alive while it accepts sessions. Persist the identity seed so
the advertised locator survives a restart. TypeScript, Python, Rust, and
Racket provide managed `noise-relay` listeners. Zig registers through the
relay provider (the `"glowcap_relay_tls"` build module, which builds Mbed
TLS from source) and `driver.listen`, with platform trust for `wss://`. A
browser page registers through `@glowcap/web` instead.

For cleartext keyed registration, use `resident(.keyed)` in Zig, `keyed.listen` in TypeScript, Python, and Rust, or
`listen-keyed-relay` in Racket. The locator is still identity-addressed, and the
relay path is not sealed.

```=html
<!-- site-examples:listen:relay GENERATED by `zig build gen-site-examples`; edits are overwritten -->
```
> []($block.attrs('code-tabs'))
> **Zig**
> ```zig
> const std = @import("std");
> const glowcap = @import("glowcap");
> const relay_tls = @import("relay_tls");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator) !void {
>     // Register this key at the relay; Noise_XK seals every accepted CapTP stream.
>     const seed = @as([32]u8, @splat(7)); // load durable secret bytes in a real service
>     const secret = glowcap.foundation.crypto.SecretKey.fromSeed(seed);
>     var tls = switch (relay_tls.initTlsOwner(io, allocator, .system)) {
>         .ready => |ready| ready.owner,
>         .failed => return error.RelayUnavailable,
>     };
>     defer switch (tls.release()) {
>         .released => {},
>         .busy, .failed => std.log.err("relay TLS teardown failed", .{}),
>     };
>     var entropy: [std.Random.DefaultCsprng.secret_seed_length]u8 = undefined;
>     try io.randomSecure(&entropy);
>     const server = try glowcap.driver.listen(
>         allocator,
>         io,
>         .{ .symbols = &.{.noise_relay}, .relay = .{
>             .url = "wss://relay.example/relay",
>             .entropy_seed = entropy,
>             .resolver_io = io,
>             .tls_owner = tls,
>             .registration = .{ .url = "wss://relay.example/register" },
>         } },
>         glowcap.ocapn.model.transport.noise_relay,
>         .{ .designator = "" },
>         .{ .keyed = secret },
>         .{ .handshake = .{ .ms = 10_000 }, .settle = .{ .ms = 10_000 } },
>     );
>     defer server.deinit();
>
>     const uri = try glowcap.ocapn.model.uri.writePeer(allocator, (try server.advertisedLocator()));
>     defer allocator.free(uri);
>     std.debug.print("{s}\n", .{uri}); // Noise seals the relay path end to end
>
>     try serve(server);
> }
> ```
> **TypeScript**
> ```ts
> import type { Argument } from "@glowcap/runtime";
> import { noise } from "@glowcap/relay";
>
> // Register this key at the relay; Noise_XK seals every accepted CapTP stream.
> const seed = crypto.getRandomValues(new Uint8Array(32));
> await using server = await noise.listen({
> 	relayUrl: "wss://relay.example/relay",
> 	registerUrl: "wss://relay.example/register",
> 	seed,
> });
> ```
> **Python**
> ```python
> import os
> from glowcap import Argument, relay
>
> # Register this key at the relay; Noise_XK seals every accepted CapTP stream.
> seed = os.urandom(32)  # load durable secret bytes in a real service
> async with await relay.noise.listen(
>     "wss://relay.example/relay",
>     "wss://relay.example/register",
>     seed=seed,
> ) as server:
> ```
> **Rust**
> ```rust
> use glowcap::{relay, Argument};
>
> // Register this key at the relay; Noise_XK seals every accepted CapTP stream.
> let seed = [7u8; 32]; // replace with durable secret bytes across restarts
> let server = relay::noise::listen(
>     "wss://relay.example/relay",
>     "wss://relay.example/register",
>     relay::ListenOptions {
>         identity: relay::ListenerIdentity::Seed(seed),
>         ..relay::ListenOptions::default()
>     },
> )
> .await?;
> ```
> **Racket**
> ```scheme
> (require "glowcap.rkt"
>          "glowcap-relay.rkt")
>
> ;; Register this key at the relay; Noise_XK seals every accepted CapTP stream.
> (define seed (make-bytes 32 7)) ; Replace with durable secret bytes.
> (define server (listen-noise-relay
>                 "wss://relay.example/relay"
>                 "wss://relay.example/register"
>                 #:seed seed))
> (printf "~a\n" (server-uri server)) ; hand this locator to partners
> (define host (server-host server))
> (define (accept-session) (accept server))
> ```
