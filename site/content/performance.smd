<rect x="30.3" y="58.4" width="66.2" height="125.6" fill="var(--teal, #257f88)" rx="2"/>
<text x="63.4" y="55.4" text-anchor="middle" font-size="9.5" fill="var(--ink, #3a3027)">85</text>
<rect x="99.5" y="18" width="66.2" height="166" fill="var(--accent, #c76f18)" rx="2"/>
<text x="132.6" y="15" text-anchor="middle" font-size="9.5" fill="var(--ink, #3a3027)">112</text>
<text x="98" y="200" text-anchor="middle" font-size="11" fill="var(--ink-soft, #6b5d4d)">encode</text>
<rect x="214.3" y="71.3" width="66.2" height="112.7" fill="var(--teal, #257f88)" rx="2"/>
<text x="247.4" y="68.3" text-anchor="middle" font-size="9.5" fill="var(--ink, #3a3027)">76</text>
<rect x="283.5" y="64.9" width="66.2" height="119.1" fill="var(--accent, #c76f18)" rx="2"/>
<text x="316.6" y="61.9" text-anchor="middle" font-size="9.5" fill="var(--ink, #3a3027)">80</text>
