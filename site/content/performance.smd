<rect x="30.3" y="18" width="66.2" height="166" fill="var(--teal, #257f88)" rx="2"/>
<text x="63.4" y="15" text-anchor="middle" font-size="9.5" fill="var(--ink, #3a3027)">134</text>
<rect x="99.5" y="89.4" width="66.2" height="94.6" fill="var(--accent, #c76f18)" rx="2"/>
<text x="132.6" y="86.4" text-anchor="middle" font-size="9.5" fill="var(--ink, #3a3027)">76</text>
<text x="98" y="200" text-anchor="middle" font-size="11" fill="var(--ink-soft, #6b5d4d)">encode</text>
<rect x="214.3" y="86.6" width="66.2" height="97.4" fill="var(--teal, #257f88)" rx="2"/>
<text x="247.4" y="83.6" text-anchor="middle" font-size="9.5" fill="var(--ink, #3a3027)">79</text>
<rect x="283.5" y="83.5" width="66.2" height="100.5" fill="var(--accent, #c76f18)" rx="2"/>
<text x="316.6" y="80.5" text-anchor="middle" font-size="9.5" fill="var(--ink, #3a3027)">81</text>
<text x="282" y="200" text-anchor="middle" font-size="11" fill="var(--ink-soft, #6b5d4d)">decode</text>
</svg>

</figure>
</div><table>
<thead><tr><th>codec</th><th>encode ns/op</th><th>decode ns/op</th><th>encode MB/s</th><th>decode MB/s</th><th>frame bytes</th></tr></thead>
<tbody>
<tr><td>Syrup</td><td>134</td><td>78.6</td><td>522</td><td>890</td><td>70</td></tr>
