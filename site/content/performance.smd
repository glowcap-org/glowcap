<rect x="214.3" y="91.9" width="66.2" height="92.1" fill="var(--teal, #257f88)" rx="2"/>
<text x="247.4" y="88.9" text-anchor="middle" font-size="9.5" fill="var(--ink, #3a3027)">93</text>
<rect x="283.5" y="90.7" width="66.2" height="93.3" fill="var(--accent, #c76f18)" rx="2"/>
<text x="316.6" y="87.7" text-anchor="middle" font-size="9.5" fill="var(--ink, #3a3027)">94</text>
