<rect x="56.38%" y="87.2" width="17.43%" height="96.8" fill="var(--teal, #257f88)" rx="2"/>
<text x="65.1%" y="84.2" text-anchor="middle" font-size="9.5" fill="var(--ink, #3a3027)">66</text>
<rect x="74.61%" y="55.7" width="17.43%" height="128.3" fill="var(--accent, #c76f18)" rx="2"/>
<text x="83.32%" y="52.7" text-anchor="middle" font-size="9.5" fill="var(--ink, #3a3027)">88</text>
