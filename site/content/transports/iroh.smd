## Listen

Listening binds the provider's node identity and returns the locator partners
can use. The matrix preserves bindings that support iroh even when a first-call
snippet is not yet published.

```=html
<!-- site-examples:listen:iroh GENERATED by `zig build gen-site-examples`; edits are overwritten -->
```
> []($block.attrs('code-tabs'))
> **Zig**
> ```zig
> const std = @import("std");
> const pancake = @import("pancake");
> const iroh = @import("iroh");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator) !void {
>     const seed = [_]u8{7} ** 32; // keep this seed to preserve the node id
>     const secret = pancake.foundation.crypto.SecretKey.fromSeed(seed);
>     var iroh_resident = try iroh.Resident.init(io, &seed, .{ .reachability = .discovery });
>     defer iroh_resident.deinit();
>     var server = try pancake.driver.listen(
>         allocator,
>         iroh_resident.netlayer(),
>         .{ .designator = "" },
>         .{ .keyed = secret },
>         .{ .handshake = .{ .ms = 10_000 }, .settle = .{ .ms = 10_000 } },
>     );
>     defer server.deinit();
>
>     const uri = try pancake.ocapn.model.uri.writePeer(allocator, (try server.advertisedLocator()));
>     defer allocator.free(uri);
>     std.debug.print("{s}\n", .{uri}); // hand this discovery-reachable node id to partners
>
>     try serve(&server);
> }
> ```
> **TypeScript**
> ```ts
> import type { Argument } from "@pancake/runtime";
> import { type IrohConfig, listen, Reachability } from "@pancake/iroh";
>
> // Bind a key, not a place. Partners can dial this node id from anywhere.
> const config: IrohConfig = { reachability: Reachability.Discovery };
> await using server = await listen(config);
> ```
> **Python**
> ```python
> from pancake import Argument
> from pancake.iroh import IrohConfig, Reachability, listen
>
> # Bind a key, not a place. Partners can dial this node id from anywhere.
> async with await listen(IrohConfig(Reachability.DISCOVERY)) as server:
> ```
> **Rust**
> ```rust
> use pancake::iroh::{self, Reachability};
> use pancake::Argument;
>
> // Bind a key, not a place. Partners can dial this node id from anywhere.
> // Cargo.toml: pancake = { …, features = ["iroh"] }
> let server = iroh::listen(
>     iroh::Config::new(Reachability::Discovery),
>     iroh::ListenOptions::default(),
> )
> .await?;
> ```
> **Racket**
> ```scheme
> (require "pancake.rkt"
>          "pancake-iroh.rkt")
>
> ;; Bind a key, not a place. Partners can dial this node id from anywhere.
> (define server (listen-iroh (make-iroh-config IROH-REACH-DISCOVERY)))
> (printf "~a\n" (iroh-server-uri server)) ; hand this locator to partners
> (define host (iroh-server-host server))
> (define (accept-session) (iroh-server-accept server))
> ```
