# Listen

Listening binds the provider's node identity and returns the locator partners
can use. The matrix preserves bindings that support iroh even when a first-call
snippet is not yet published.

```=html
<!-- site-examples:listen:iroh GENERATED by `zig build gen-site-examples`; edits are overwritten -->
```
> []($block.attrs('code-tabs'))
> **Zig**
> ```zig
> const std = @import("std");
> const glowcap = @import("glowcap");
> const iroh = @import("iroh");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator) !void {
>     var seed: [32]u8 = undefined;
>     try io.randomSecure(&seed); // retain this seed to restore the node identity
>     const secret = glowcap.foundation.crypto.SecretKey.fromSeed(seed);
>     var endpoint = try iroh.Resident.init(io, &seed, .{ .reachability = .discovery });
>     defer endpoint.deinit() catch |err| std.log.err("iroh endpoint: {s}", .{@errorName(err)});
>     var adapter = try iroh.MultiplexedAdapter.init(allocator, &endpoint);
>     defer if (adapter.deinit()) |failure| std.log.err("iroh adapter: {s}", .{failure.primaryName()});
>     const providers = [_]glowcap.driver.HostRuntime.ProviderRegistration{.{
>         .multiplexed = .{ .profile = iroh.transport_profile, .resident = adapter.multiplexed() },
>     }};
>     const server = try glowcap.driver.listenProviders(
>         allocator,
>         io,
>         &providers,
>         iroh.transport_name,
>         .{ .designator = "" },
>         .{ .keyed = secret },
>         .{ .handshake = .{ .ms = 10_000 }, .settle = .{ .ms = 10_000 } },
>     );
>     defer server.deinit();
>
>     const uri = try glowcap.ocapn.model.uri.writePeer(allocator, (try server.advertisedLocator()));
>     defer allocator.free(uri);
>     std.debug.print("{s}\n", .{uri}); // hand this locator to partners
>
>     try serve(server);
> }
> ```
> **TypeScript**
> ```ts
> import type { Argument } from "@glowcap/runtime";
> import { type IrohConfig, listen, Reachability } from "@glowcap/iroh";
>
> // This listener is named by its node id. Partners can dial it from anywhere.
> const config: IrohConfig = { reachability: Reachability.Discovery };
> await using server = await listen(config);
> ```
> **Python**
> ```python
> from glowcap import Argument
> from glowcap.iroh import IrohConfig, Reachability, listen
>
> # This listener is named by its node id. Partners can dial it from anywhere.
> async with await listen(IrohConfig(Reachability.DISCOVERY)) as server:
> ```
> **Rust**
> ```rust
> use glowcap::iroh::{self, Reachability};
> use glowcap::Argument;
>
> // This listener is named by its node id. Partners can dial it from anywhere.
> // Cargo.toml: glowcap = { …, features = ["iroh"] }
> let server = iroh::listen(
>     iroh::Config::new(Reachability::Discovery),
>     iroh::ListenOptions::default(),
> )
> .await?;
> ```
> **Racket**
> ```scheme
> (require "glowcap.rkt"
>          "glowcap-iroh.rkt")
>
> ;; This listener is named by its node id. Partners can dial it from anywhere.
> (define server (listen-iroh (make-iroh-config IROH-REACH-DISCOVERY)))
> (printf "~a\n" (iroh-server-uri server)) ; hand this locator to partners
> (define host (iroh-server-host server))
> (define (accept-session) (iroh-server-accept server))
> ```
