## Listen

The listen axis keeps conventional listeners separate from relay rendezvous
registration. A missing tab is a real binding or example boundary, not a
promise that a relay service is a listener.

```=html
<!-- site-examples:listen:noise GENERATED by `zig build gen-site-examples`; edits are overwritten -->
```
### TCP

> []($block.attrs('code-tabs'))
> **Zig**
> ```zig
> const std = @import("std");
> const pancake = @import("pancake");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator) !void {
>     const seed = [_]u8{7} ** 32; // load durable secret bytes in a real service
>     const secret = pancake.foundation.crypto.SecretKey.fromSeed(seed);
>     var noise_resident = pancake.net.tcp.noise.Resident{ .io = io };
>     var server = try pancake.driver.listen(
>         allocator,
>         noise_resident.netlayer(),
>         .{ .designator = "127.0.0.1:9099" },
>         .{ .keyed = secret },
>         .{ .handshake = .{ .ms = 10_000 }, .settle = .{ .ms = 10_000 } },
>     );
>     defer server.deinit();
>
>     const uri = try pancake.ocapn.model.uri.writePeer(allocator, (try server.advertisedLocator()));
>     defer allocator.free(uri);
>     std.debug.print("{s}\n", .{uri}); // Noise proves this durable key to dialers
>
>     try serve(&server);
> }
> ```
> **TypeScript**
> ```ts
> import type { Argument } from "@pancake/runtime";
> import { noise } from "@pancake/tcp";
>
> // Same bind as keyed-tcp; Noise_XK seals every accepted CapTP stream.
> const seed = crypto.getRandomValues(new Uint8Array(32));
> await using server = await noise.listen("127.0.0.1", 9099, { seed });
> ```
> **Python**
> ```python
> import os
> from pancake import Argument, tcp
>
> # Same bind as keyed-tcp; Noise_XK seals every accepted CapTP stream.
> # Persist the 32-byte seed to keep the same key.
> seed = os.urandom(32)
> async with await tcp.noise.listen("127.0.0.1", 9099, seed=seed) as server:
> ```
> **Rust**
> ```rust
> use pancake::{tcp, Argument};
>
> // Same bind as keyed-tcp; Noise_XK seals every accepted CapTP stream.
> let seed = [7u8; 32]; // replace with durable secret bytes across restarts
> let server = tcp::noise::listen(
>     "127.0.0.1",
>     9099,
>     tcp::KeyedListenOptions {
>         identity: tcp::ListenerIdentity::Seed(seed),
>         ..tcp::KeyedListenOptions::default()
>     },
> )
> .await?;
> ```
> **Racket**
> ```scheme
> (require "pancake.rkt"
>          "pancake-tcp.rkt")
>
> ;; Same bind as keyed-tcp; Noise_XK seals every accepted CapTP stream.
> (define seed (make-bytes 32 7)) ; Replace with durable secret bytes.
> (define server (listen-noise-tcp "127.0.0.1" 9099 #:seed seed))
> (printf "~a\n" (server-uri server)) ; hand this locator to partners
> (define host (server-host server))
> (define (accept-session) (accept server))
> ```

### Relay

> []($block.attrs('code-tabs'))
> **Zig**
> ```zig
> const std = @import("std");
> const pancake = @import("pancake");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator) !void {
>     const seed = [_]u8{7} ** 32; // load durable secret bytes in a real service
>     const secret = pancake.foundation.crypto.SecretKey.fromSeed(seed);
>     var relay_resident = try pancake.net.relay.Resident.initRegisteredProfile(
>         allocator,
>         io,
>         "ws://192.0.2.10:8080/relay",
>         "ws://192.0.2.10:8080/register",
>         secret.publicKey(),
>         .noise,
>     );
>     defer relay_resident.deinit();
>     var server = try pancake.driver.listen(
>         allocator,
>         relay_resident.netlayer(),
>         .{ .designator = "" },
>         .{ .keyed = secret },
>         .{ .handshake = .{ .ms = 10_000 }, .settle = .{ .ms = 10_000 } },
>     );
>     defer server.deinit();
>
>     const uri = try pancake.ocapn.model.uri.writePeer(allocator, (try server.advertisedLocator()));
>     defer allocator.free(uri);
>     std.debug.print("{s}\n", .{uri}); // Noise seals the relay path end to end
>
>     try serve(&server);
> }
> ```
