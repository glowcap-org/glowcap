## TCP

> []($block.attrs('code-tabs'))
> **Zig**
> ```zig
> const std = @import("std");
> const glowcap = @import("glowcap");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator) !void {
>     // Same TCP sockets as cleartext keyed dialing; Noise_XK seals the CapTP stream.
>     // The designator is the peer's durable key; the hint is where to dial.
>     var hint_storage: [1]glowcap.ocapn.model.HintEntry = undefined;
>     const peer_key = "<64 lowercase hex characters from the server>";
>     const partner = glowcap.net.tcp.noise.locator(
>         peer_key,
>         "127.0.0.1:9099",
>         &hint_storage,
>     );
>
>     const session = try glowcap.driver.connect(
>         allocator,
>         io,
>         .{ .symbols = &.{.noise_tcp} },
>         partner,
>         .ephemeral,
>         .{ .handshake = .{ .ms = 10_000 }, .settle = .{ .ms = 10_000 } },
>     );
> ```
> **TypeScript**
> ```ts
> import { noise, provider } from "@glowcap/tcp";
> import { Runtime } from "@glowcap/runtime";
>
> // Same TCP sockets as keyed dialing; Noise_XK seals the CapTP stream.
> const peerKey = "<64 lowercase hex characters from the server>";
> const partner = noise.locator(peerKey, "127.0.0.1", 9099);
>
> await using runtime = await Runtime.open({ providers: [provider()] });
> ```
> **Python**
> ```python
> from glowcap import Runtime, tcp
>
> # Same TCP sockets as keyed dialing; Noise_XK seals the CapTP stream.
> peer_key = "<64 lowercase hex characters from the server>"
> partner = tcp.noise.locator(peer_key, "127.0.0.1", 9099)
>
> async with Runtime.open(provider=tcp.provider()) as runtime:
> ```
> **Rust**
> ```rust
> use glowcap::{tcp, Argument, ConnectOptions, PendingWork, Runtime, RuntimeConfig};
>
> // Same TCP sockets as keyed dialing; Noise_XK seals the CapTP stream.
> let peer_key = "<64 lowercase hex characters from the server>";
> let partner = tcp::noise::locator(peer_key, "127.0.0.1", 9099);
>
> let runtime = Runtime::open(RuntimeConfig::providers([tcp::provider(tcp::Config::default())])).await?;
> ```
> **Racket**
> ```scheme
> (require "glowcap.rkt" "glowcap-tcp.rkt")
>
> ;; Same TCP sockets as keyed dialing; Noise_XK seals the CapTP stream.
> (define peer-key "<64 lowercase hex characters from the server>")
> (define partner (noise-tcp-locator peer-key "127.0.0.1" 9099))
>
> (define runtime (open-runtime #:providers (list (tcp-provider))))
> ```

## Relay

> []($block.attrs('code-tabs'))
> **Zig**
> ```zig
> const std = @import("std");
> const glowcap = @import("glowcap");
> const native_relay = @import("native_relay");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator) !void {
>     // Noise_XK seals the session end to end; the relay forwards ciphertext.
>     const relay_url = "wss://relay.example/relay";
>     var tls = switch (native_relay.initTlsOwner(io, allocator, .system)) {
>         .ready => |ready| ready.owner,
>         .failed => return error.RelayUnavailable,
>     };
>     defer switch (tls.release()) {
>         .released => {},
>         .busy, .failed => std.log.err("relay TLS teardown failed", .{}),
>     };
>     var entropy: [std.Random.DefaultCsprng.secret_seed_length]u8 = undefined;
>     try io.randomSecure(&entropy);
>     const transports: glowcap.driver.Transports = .{ .symbols = &.{.noise_relay}, .relay = .{
>         .url = relay_url,
>         .entropy_seed = entropy,
>         .resolver_io = io,
>         .tls_owner = tls,
>     } };
>     var hint_storage: [1]glowcap.ocapn.model.HintEntry = undefined;
>     const peer_key = "<64 lowercase hex characters from the server>";
>     const partner = glowcap.net.relay.noise.locator(peer_key, relay_url, &hint_storage);
>     const session = try glowcap.driver.connect(
>         allocator,
>         io,
>         transports,
>         partner,
>         .ephemeral,
>         .{ .handshake = .{ .ms = 10_000 }, .settle = .{ .ms = 10_000 } },
>     );
> ```
> **TypeScript**
> ```ts
> import { Runtime } from "@glowcap/runtime";
> import { noise, provider } from "@glowcap/relay";
>
> // Noise_XK seals the session end to end; the relay forwards ciphertext.
> const peerKey = "<64 lowercase hex characters from the server>";
> const relayUrl = "wss://relay.example/relay";
> const partner = noise.locator(peerKey, relayUrl);
>
> await using runtime = await Runtime.open({
> 	providers: [provider({ relayUrl })],
> });
> ```
> **Browser**
> ```ts
> import { connector, noise } from "@glowcap/relay";
> import { init } from "@glowcap/web";
>
> const relayUrl = "wss://relay.example/relay";
> const web = await init({
> 	wasm: fetch("/glowcap_host.wasm"),
> 	connectors: [connector()],
> });
> await using runtime = web.runtime;
> const partner = noise.locator("<64 lowercase hex characters>", relayUrl);
> ```
> **Python**
> ```python
> from glowcap import Runtime, relay
>
> # Noise_XK seals the CapTP stream end to end through the relay.
> peer_key = "<64 lowercase hex characters from the server>"
> relay_url = "wss://relay.example/relay"
> partner = relay.noise.locator(peer_key, relay_url)
>
> async with Runtime.open(provider=relay.provider(relay_url)) as runtime:
> ```
> **Rust**
> ```rust
> use glowcap::{relay, Argument, ConnectOptions, PendingWork, Runtime, RuntimeConfig};
>
> // Noise_XK seals the CapTP stream end to end through the relay.
> let peer_key = "<64 lowercase hex characters from the server>";
> let relay_url = "wss://relay.example/relay";
> let partner = relay::noise::locator(peer_key, relay_url);
> let runtime = Runtime::open(RuntimeConfig::providers([relay::provider(
> 	relay::Config::dial_only(relay_url),
> )]))
> .await?;
> ```
> **Racket**
> ```scheme
> (require "glowcap.rkt" "glowcap-relay.rkt")
>
> ;; Noise_XK seals the CapTP stream end to end through the relay.
> (define peer-key "<64 lowercase hex characters from the server>")
> (define relay-url "wss://relay.example/relay")
> (define partner (noise-relay-locator peer-key relay-url))
> (define runtime
>   (open-runtime #:providers (list (relay-provider #:relay-url relay-url))))
> ```
