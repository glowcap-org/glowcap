# Listen

Listening asks your Tor daemon to create the onion service and returns the
locator partners dial. The session is the same CapTP `Session` as on every
other transport. A program that moves frames itself can use the raw onion
Netlayer the bindings expose.

```=html
<!-- site-examples:listen:onion GENERATED by `zig build gen-site-examples`; edits are overwritten -->
```
> []($block.attrs('code-tabs'))
> **Zig**
> ```zig
> const std = @import("std");
> const glowcap = @import("glowcap");
>
> pub fn example(io: std.Io, allocator: std.mem.Allocator) !void {
>     // glowcap starts no Tor. Name an already-running daemon's SOCKS and control ports.
>     const server = try glowcap.driver.listen(
>         allocator,
>         io,
>         .{ .symbols = &.{.onion}, .onion = .{
>             .socks = try glowcap.net.tcp.parseDesignator("127.0.0.1:9050"),
>             .control = try glowcap.net.tcp.parseDesignator("127.0.0.1:9051"),
>         } },
>         glowcap.ocapn.model.transport.onion,
>         .{ .designator = "" },
>         .ephemeral,
>         .{ .handshake = .{ .ms = 10_000 }, .settle = .{ .ms = 10_000 } },
>     );
>     defer server.deinit();
>
>     const uri = try glowcap.ocapn.model.uri.writePeer(allocator, (try server.advertisedLocator()));
>     defer allocator.free(uri);
>     std.debug.print("{s}\n", .{uri}); // hand this locator to partners
>
>     var service_key_storage: [256]u8 = undefined;
>     const key_len = (try server.restorationState(&service_key_storage)) orelse
>         return error.RestorationStateUnavailable;
>     const service_key = service_key_storage[0..key_len];
>     _ = service_key; // persist securely to restore this service
>
>     try serve(server);
> }
> ```
> **TypeScript**
> ```ts
> import type { Argument } from "@glowcap/runtime";
> import { listen } from "@glowcap/onion";
>
> // glowcap starts no Tor. Name an already-running daemon's SOCKS (and control to host).
> await using server = await listen({
> 	socks: "/run/tor/socks",
> 	control: "/run/tor/control",
> });
> const _serviceKey = server.serviceKey; // persist securely to restore this service
> ```
> **Python**
> ```python
> from glowcap import Argument, onion
>
> # glowcap starts no Tor. Name an already-running daemon's SOCKS (and control to host).
> async with await onion.listen("/run/tor/socks", control="/run/tor/control") as server:
>     service_key = server.service_key  # persist securely to restore this service
> ```
> **Rust**
> ```rust
> use glowcap::onion::{self, Auth, Config};
> use glowcap::Argument;
>
> // glowcap starts no Tor. Name an already-running daemon's SOCKS (and control to host).
> let config = Config::dial_only("/run/tor/socks")
>     .with_control("/run/tor/control", Auth::None);
> let server = onion::listen(config, onion::ListenOptions::default()).await?;
> let service_key = server.service_key(); // persist securely to restore this service
> ```
> **Racket**
> ```scheme
> (require "glowcap.rkt" "glowcap-onion.rkt")
>
> ;; glowcap starts no Tor. Name an already-running daemon's SOCKS (and control to host).
> (define server (listen-onion #:socks "/run/tor/socks"
>                              #:control "/run/tor/control"))
> (printf "~a\n" (onion-server-uri server)) ; hand this locator to partners
> (define service-key (onion-server-service-key server)) ; persist securely
> (define host (onion-server-host server))
> (define (accept-session) (onion-server-accept server))
> ```
