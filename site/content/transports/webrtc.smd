---
.title = "WebRTC: peer-to-peer for the browser",
.description = "WebRTC carries a glowcap session over an encrypted DataChannel, with direct browser-to-browser channels after signaling.",
.date = .date("2026-07-22T00:00:00"),
.layout = "page.shtml",
.draft = false,
---

WebRTC carries glowcap between browsers over a direct
[WebRTC](https://www.w3.org/TR/webrtc/) DataChannel, encrypted with DTLS, with
no server on the byte path. A WebRTC peer has no address to dial, so both ends set up the connection by exchanging messages through a capability they can already reach. That exchange is called signaling.

# Dial

```=html
<!-- site-examples:dial:webrtc GENERATED by `zig build gen-site-examples`; edits are overwritten -->
```
> []($block.attrs('code-tabs'))
> **Zig**
> ```zig
> const std = @import("std");
> const glowcap = @import("glowcap");
> const webrtc = @import("webrtc");
>
> // `signaling` carries the offer and each candidate to the peer the locator
> // names, over a path you already hold, such as an OCapN capability both peers
> // can reach. The answer comes back through `Backend.provideAnswer`.
> pub fn example(io: std.Io, allocator: std.mem.Allocator, partner_uri: []const u8, signaling: webrtc.SignalingAuthority) !void {
>     const partner = try glowcap.ocapn.model.uri.parsePeer(allocator, partner_uri);
>     defer glowcap.ocapn.model.freePeerLocator(allocator, partner);
>     var endpoint = try webrtc.Resident.init(.{});
>     defer endpoint.deinit() catch |err| std.log.err("webrtc endpoint: {s}", .{@errorName(err)});
>     var resident = try webrtc.CompletionResident.init(
>         allocator,
>         try webrtc.Backend.initBound(allocator, &endpoint, signaling, 256, 16 * 1024),
>         .{},
>     );
>     defer resident.deinit();
>     const residents = [_]glowcap.driver.HostRuntime.ProviderRegistration{
>         .{ .profile = webrtc.transport_profile, .resident = resident.resident() },
>     };
>
>     const session = try glowcap.driver.connect(
>         allocator,
>         io,
>         .{ .residents = &residents },
>         partner,
>         .ephemeral,
>         .{ .handshake = .{ .ms = 10_000 }, .settle = .{ .ms = 10_000 } },
>     );
> ```
> **TypeScript**
> ```ts
> import { Runtime } from "@glowcap/runtime";
> import { locator } from "@glowcap/webrtc";
> import { provider, type SignalingAuthority } from "@glowcap/webrtc/driver";
>
> // Your signaling carries the offer and each candidate to the peer the locator
> // names, over a path you already hold, such as an OCapN capability both peers
> // can reach, and brings the answer and the peer's candidates back. In a
> // browser, `connector(signaling)` from `@glowcap/webrtc` takes its place.
> declare const signaling: SignalingAuthority;
> const peerKey = "<64 lowercase hex characters from the peer>";
> const partner = locator(peerKey);
>
> await using runtime = await Runtime.open({
> 	providers: [provider(signaling)],
> });
> ```
> **Browser**
> ```ts
> import { connector, locator, type SignalingAuthority } from "@glowcap/webrtc";
> import { init } from "@glowcap/web";
>
> declare const signaling: SignalingAuthority;
> const web = await init({
> 	wasm: fetch("/glowcap_host.wasm"),
> 	connectors: [connector(signaling)],
> });
> await using runtime = web.runtime;
> const partner = locator("<64 lowercase hex characters from the peer>");
> ```
> **Python**
> ```python
> from glowcap import Runtime
> from glowcap.webrtc import SignalingAuthority, locator, provider
>
> # Your signaling carries the offer and each candidate to the peer the locator
> # names, over a path you already hold, such as an OCapN capability both peers
> # can reach, and brings the answer and the peer's candidates back.
> signaling: SignalingAuthority
> partner = locator("<64 lowercase hex characters from the peer>")
>
> async with Runtime.open(provider=provider(signaling)) as runtime:
> ```
> **Rust**
> ```rust
> use std::rc::Rc;
>
> use glowcap::webrtc::{self, SignalingAuthority};
> use glowcap::{Argument, ConnectOptions, PendingWork, Runtime, RuntimeConfig};
>
> // Your signaling carries the offer and each candidate to the peer the locator
> // names, over a path you already hold, such as an OCapN capability both peers
> // can reach, and brings the answer and the peer's candidates back. Drive the
> // runtime from a tokio `LocalSet`: the callbacks run on the thread that steps it.
> // Cargo.toml: glowcap = { …, features = ["webrtc"] }
> let signaling: Rc<dyn SignalingAuthority> = todo!("your SignalingAuthority");
> let partner = webrtc::locator("<64 lowercase hex characters from the peer>");
>
> let runtime =
>     Runtime::open(RuntimeConfig::providers([webrtc::provider(signaling, webrtc::Config::default())])).await?;
> ```
> **Racket**
> ```scheme
> (require "glowcap.rkt"
>          "glowcap-webrtc.rkt")
>
> ;; Your signaling carries the offer and each candidate to the peer the locator
> ;; names, over a path you already hold, such as an OCapN capability both peers
> ;; can reach, and brings the answer and the peer's candidates back.
> (define signaling
>   (make-webrtc-signaling
>    #:offer (lambda (exchange peer sdp) (error "send the offer, return the answer"))
>    #:answer (lambda (exchange peer sdp) (error "send the answer to an inbound offer"))
>    #:candidate (lambda (exchange ice) (error "send one candidate"))
>    #:on-candidate (lambda (exchange peer sink) (error "call sink with each far candidate"))))
> (define partner (webrtc-locator "<64 lowercase hex characters from the peer>"))
>
> (define runtime (open-runtime #:providers (list (webrtc-provider signaling))))
> ```
