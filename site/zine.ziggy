.zine_version = "0.14.1-dev",
.supermd = .{
    .headings_h2 = true,
},
.site = .simple(.{
    .title = "glowcap",
    // The published origin, used for canonical and sitemap URLs. The
    // repository's Pages settings bind the domain to the deployment.
    .host_url = "https://glowcap.org",
    .url_path_prefix = "",
    .content_dir_path = "content",
    .layouts_dir_path = "layouts",
    .assets_dir_path = "assets",
    // Served whether or not a page links them: the one-command installer,
    // the Rooms page `zig build site-rooms-page` exports under rooms/app, and
    // the visualizer `zig build site-ocapnviz-page` builds under ocapnviz.
    // Each directory here is an application with its own entry document, and
    // the site's checks read this list to tell one from an authored page.
    .static_assets = ["install.sh", "rooms/app/", "ocapnviz/"],
}),
