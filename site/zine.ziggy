.zine_version = "0.14.1-dev",
.supermd = .{
    .headings_h2 = true,
},
.site = .simple(.{
    .title = "glowcap",
    // The published origin, used for canonical and sitemap URLs. GitHub Pages
    // serves it from the CNAME file the site build installs at the output root.
    .host_url = "https://glowcap.org",
    .url_path_prefix = "",
    .content_dir_path = "content",
    .layouts_dir_path = "layouts",
    .assets_dir_path = "assets",
}),
