Site {
    .title = "pancake",
    // Canonical and sitemap URLs are built from this host, so it names where
    // the site is actually served: GitHub Pages, deployed by
    // .github/workflows/pages.yml on every push to main.
    .host_url = "https://jimisaacs.github.io",
    .url_path_prefix = "pancake",
    .content_dir_path = "content",
    .layouts_dir_path = "layouts",
    .assets_dir_path = "assets",
}
