use pancake::onion::{Auth, Config, Netlayer};
use pancake::Codec;

// pancake starts no Tor. Name an already-running daemon's SOCKS (and control to host).
let config = Config::dial_only("/run/tor/socks")
    .with_control("/run/tor/control", Auth::None);
let netlayer = Netlayer::new(&config)?;
let listener = netlayer.listen()?;
println!("ocapn://{}.onion", listener.service_id()); // Goblins-standard locator
let _connection = listener.accept(Codec::Syrup, 4096)?;
// Frame I/O here; CapTP rides pancake's Host over this byte channel.
