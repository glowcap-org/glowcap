import { Netlayer } from "@pancake/stack/transport/onion";

// pancake starts no Tor. Name an already-running daemon's SOCKS (and control to host).
using netlayer = new Netlayer({
  socks: "/run/tor/socks",
  control: "/run/tor/control",
});
using listener = await netlayer.listen();
console.log(`ocapn://${listener.serviceId}.onion`); // Goblins-standard locator
using connection = await listener.accept();
// Frame I/O here; CapTP rides pancake's Host over this byte channel.
