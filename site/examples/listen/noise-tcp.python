import os
from pancake import listen_noise_tcp

# Same bind as keyed-tcp; Noise_XK seals every accepted CapTP stream.
# Persist the 32-byte seed to keep the same key.
seed = os.urandom(32)
server = await listen_noise_tcp("127.0.0.1", 9099, seed=seed)
print(server.uri)  # hand this locator to partners
async for session in server:
    session.publish("greeter", lambda _verb, args: f"hello, {args[0]}")
    session.serve()
