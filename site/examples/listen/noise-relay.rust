use glowcap::{relay, Argument};

// Register this key at the relay; Noise_XK seals every accepted CapTP stream.
let seed = [7u8; 32]; // replace with durable secret bytes across restarts
let server = relay::noise::listen(
    "wss://relay.example/relay",
    "wss://relay.example/register",
    relay::ListenOptions {
        identity: relay::ListenerIdentity::Seed(seed),
        ..relay::ListenOptions::default()
    },
)
.await?;
// From here, the CapTP workflow is transport-independent.
println!("{}", server.uri()?); // hand this locator to partners
server.host().publish("greeter", || Box::new(greeter))?;
loop {
    let session = server.accept().await?;
    session.serve().await?;
}

fn greeter(verb: &str, args: &[Argument]) -> Result<Argument, String> {
    if verb != "greet" {
        return Err("no such method".into());
    }
    let Some(Argument::String(name)) = args.first() else {
        return Err("bad invocation".into());
    };
    Ok(Argument::String(format!("Hello, {name}").into()))
}
