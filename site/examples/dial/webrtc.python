from glowcap import Runtime
from glowcap.webrtc import SignalingAuthority, locator, provider

# Your signaling carries the offer and each candidate to the peer the locator
# names, over a path you already hold, such as an OCapN capability both peers
# can reach, and brings the answer and the peer's candidates back.
signaling: SignalingAuthority
partner = locator("<64 lowercase hex characters from the peer>")

async with Runtime.open(provider=provider(signaling)) as runtime:
    # From here, the CapTP workflow is transport-independent.
    async with await runtime.connect(partner) as session:
        greeter = await session.fetch("greeter")  # a capability this peer published
        reply = await session.send(greeter, "greet", ["world"])
        print(reply)
