(require "glowcap.rkt"
         "glowcap-webrtc.rkt")

;; Your signaling carries the offer and each candidate to the peer the locator
;; names, over a path you already hold, such as an OCapN capability both peers
;; can reach, and brings the answer and the peer's candidates back.
(define signaling
  (make-webrtc-signaling
   #:offer (lambda (exchange peer sdp) (error "send the offer, return the answer"))
   #:answer (lambda (exchange peer sdp) (error "send the answer to an inbound offer"))
   #:candidate (lambda (exchange ice) (error "send one candidate"))
   #:on-candidate (lambda (exchange peer sink) (error "call sink with each far candidate"))))
(define partner (webrtc-locator "<64 lowercase hex characters from the peer>"))

(define runtime (open-runtime #:providers (list (webrtc-provider signaling))))
;; From here, the CapTP workflow is transport-independent.
(define session (runtime-connect runtime partner))
(define greeter (session-fetch session "greeter")) ; a capability this peer published
(printf "~a\n" (session-send session greeter 'greet "world"))
(session-close! session)
(runtime-close! runtime)
