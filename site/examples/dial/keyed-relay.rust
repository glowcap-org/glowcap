use pancake::{relay, Argument, ConnectOptions, PendingWork, Runtime, RuntimeConfig};

// The key names the peer; the hint names the relay that can reach it.
let peer_key = "<64 lowercase hex characters from the server>";
let relay_url = "wss://relay.example/relay";
let partner = relay::keyed::locator(peer_key, relay_url);
let runtime = Runtime::open(RuntimeConfig::providers([relay::provider(
	relay::Config::dial_only(relay_url),
)]))
.await?;
// From here, the CapTP workflow is transport-independent.
let session = runtime.connect(&partner, ConnectOptions::default()).await?;
let greeter = session.fetch("greeter").await?; // a capability this peer published
match session.send(&greeter, "greet", &["world".into()]).await {
    Ok(Argument::String(reply)) => println!("{reply}"),
    Ok(other) => println!("unexpected reply: {other:?}"),
    Err(reason) => eprintln!("the greeter refused: {reason:?}"),
}
session.close(PendingWork::Cancel).await?;
runtime.close(PendingWork::Cancel).await?;
