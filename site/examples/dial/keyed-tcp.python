from glowcap import Runtime, tcp

# Key designator, cleartext CapTP. Partners dial the public key; the host:port is a hint.
peer_key = "<64 lowercase hex characters from the server>"
partner = tcp.keyed.locator(peer_key, "127.0.0.1", 9099)

async with Runtime.open(provider=tcp.provider()) as runtime:
    # From here, the CapTP workflow is transport-independent.
    async with await runtime.connect(partner) as session:
        greeter = await session.fetch("greeter")  # a capability this peer published
        reply = await session.send(greeter, "greet", ["world"])
        print(reply)
