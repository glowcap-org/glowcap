(require "pancake.rkt" "pancake-relay.rkt")

;; The key names the peer; the hint names the relay that can reach it.
(define peer-key "<64 lowercase hex characters from the server>")
(define relay-url "wss://relay.example/relay")
(define partner (keyed-relay-locator peer-key relay-url))
(define runtime
  (open-runtime #:providers (list (relay-provider #:relay-url relay-url))))
;; From here, the CapTP workflow is transport-independent.
(define session (runtime-connect runtime partner))
(define greeter (session-fetch session "greeter")) ; a capability this peer published
(printf "~a\n" (session-send session greeter 'greet "world"))
(session-close! session)
(runtime-close! runtime)
