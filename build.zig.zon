.{
    .name = .glowcap,
    .version = "0.1.7",
    .dependencies = .{
        // Lazy on purpose: libvaxis backs the CapTP lab REPL in the product
        // CLI and nothing in the `glowcap` library module. A consumer that
        // depends on glowcap as a package must not fetch a terminal UI it
        // never links, so the CLI steps resolve it and library builds do not.
        // dep vaxis: The terminal UI behind the CLI's REPL. Only the CLI fetches it.
        .vaxis = .{
            .url = "git+https://github.com/rockorager/libvaxis#c6c23fbda5b2fb2aa277fe4c02b4efb27bb4e376",
            .hash = "vaxis-0.6.0-BWNV_PW0DQAHFemkOYfxWOatp7EmUgBajplto8z86mjG",
            .lazy = true,
        },
        // The LMDB 1.0.2 release from OpenLDAP's official GitHub mirror. The
        // Loam LMDB backend compiles its `libraries/liblmdb` sources.
        // dep lmdb: The on-disk store behind Loam's LMDB backend, built from OpenLDAP's C sources.
        .lmdb = .{
            .url = "git+https://github.com/LMDB/lmdb#c279e0477c713076893e8c2b1a6337e421c15867",
            .hash = "N-V-__8AAJKDCgDQPnDfQRUzADR1nd4HE1fZUxK_aFADGNjk",
        },
        // The SQLite 3.54.1 amalgamation from sqlite.org. The Loam SQLite
        // engine compiles `sqlite3.c` with the build options in
        // `tools/build/loam/sqlite.zig`.
        // dep sqlite: The on-disk store behind Loam's SQLite engine, built from the public domain amalgamation.
        .sqlite = .{
            .url = "https://sqlite.org/2026/sqlite-amalgamation-3540100.zip",
            .hash = "N-V-__8AAETTsABEodUZZFAyfdAm9hEyqBXuLw9pRSO0vFh9",
        },
    },
    .fingerprint = 0x27b3442e3f8ed58d,
    .minimum_zig_version = "0.17.1",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "include",
        "tools",
        // Optional transport modules compile their Rust sidecars by path.
        "transports/iroh",
        "transports/webrtc",
        "transports/sidecar-runtime",
        "transports/Cargo.toml",
        "transports/Cargo.lock",
        "transports/sidecars.rs",
        "transports/ffi_handles.rs",
        // README links its checked Quick Start example.
        "examples",
        "LICENSE-THIRD-PARTY",
        "LICENSE-APACHE",
        "README.md",
    },
}
