.{
    .name = .glowcap,
    .version = "0.1.0",
    .dependencies = .{
        // Lazy on purpose: libvaxis backs the CapTP lab REPL in the product
        // CLI and nothing in the `glowcap` library module. A consumer that
        // depends on glowcap as a package must not fetch a terminal UI it
        // never links, so the CLI steps resolve it and library builds do not.
        .vaxis = .{
            .path = "third_party/libvaxis",
            .lazy = true,
        },
    },
    .fingerprint = 0x27b3442e3f8ed58d,
    .minimum_zig_version = "0.17.0-dev.2294+71403f299",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "include",
        "tools",
        "third_party",
        // `build()` names these from steps a package consumer never runs, but
        // a manifest that omits a path its own build file references is a
        // packaged build that cannot describe itself.
        "cli",
        "test",
        "examples",
        "LICENSE-THIRD-PARTY",
        "LICENSE-APACHE",
        "README.md",
    },
}
