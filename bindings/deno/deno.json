{
  "name": "@pancake/deno",
  "version": "0.1.0",
  "exports": "./pancake.ts",
  "tasks": {
    "smoke": "deno run --allow-ffi --allow-read zig_smoke.ts",
    "check": "deno check pancake.ts zig_smoke.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
