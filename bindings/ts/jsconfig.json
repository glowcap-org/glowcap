{
	// Bun resolves bare specifiers through the nearest tsconfig/jsconfig
	// `paths`; Deno uses the deno.json workspace and ignores this file (a
	// tsconfig.json here would perturb `deno check`, so it is a jsconfig on
	// purpose). The two maps name the same packages, so `@pancake/*` resolves
	// identically on both runtimes (`deno-dogfood` / `bun-dogfood` hold it).
	"compilerOptions": {
		"paths": {
			"@pancake/abi": ["./abi/constants.ts"],
			"@pancake/runtime": ["./runtime/mod.ts"],
			"@pancake/runtime/transport": ["./runtime/transport.ts"],
			"@pancake/tcp": ["./tcp/mod.ts"],
			"@pancake/tcp/transport": ["./tcp/transport.ts"],
			"@pancake/inproc": ["./inproc/mod.ts"],
			"@pancake/onion": ["./onion/mod.ts"],
			"@pancake/relay": ["./relay/mod.ts"],
			"@pancake/runtime/ffi": ["./runtime/ffi.ts"],
			"@pancake/iroh": ["./iroh/mod.ts"],
			"@pancake/iroh/internal": ["./iroh/internal.ts"],
			"@pancake/web": ["./web/mod.ts"]
		}
	}
}
