{
  "workspace": [
    "./stack",
    "./iroh"
  ],
  "fmt": {
    "useTabs": true,
    "indentWidth": 4,
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false,
    "include": [
      "**/*.ts"
    ],
    "exclude": [
      "stack/internal/abi.ts"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
