#lang racket/base
;; Independent reference occurrences survive release and opaque-object resolution.
(require "prelude.rkt" racket/async-channel)
(define pending-resolvers (make-async-channel))

(define server (listen "127.0.0.1" 0))
(define serving
  (thread
   (lambda ()
     (for ([_ (in-range 2)])
       (define session (accept server))
       (define m (session-host session))
       (define result (session-spawn session (lambda (bcom) (methods [(ping) "remote alive"]))))
       (host-publish m "echo" (lambda (verb . args) (car args)))
       (host-publish m "worker"
                     (lambda (verb . args)
                       (async-channel-put pending-resolvers (cons (host-defer-turn m) result))
                       (void)))
       (thread (lambda () (session-serve session)))))))
(for ([gc? '(#f #t)])
  (define session (open-test-session (tcp-locator "127.0.0.1" (server-port server))))
  (when gc? (session-with-gc! session))
  (define m (session-host session))
  (define original (session-spawn session (lambda (bcom) (methods [(ping) "alive"]))))
  (define held (host-retain-reference m original))
  (expect (and (not (eq? held original)) (equal? held original)) "retain: independent wrapper, same identity")
  (session-release! session original)
  (expect (equal? "alive" (session-send session held 'ping)) "retain: releasing source preserves retained occurrence")
  (define resolved (session-resolve session held))
  (expect (and (ref? resolved) (not (eq? held resolved))) "resolve: independent reference occurrence")
  (host-release-reference! m held)
  (expect (equal? "alive" (session-send session resolved 'ping)) "resolve: releasing source preserves resolved occurrence")
  (define foreign (make-fresh-host))
  (for ([owner (list m foreign)] [ref (list held resolved)])
    (expect (with-handlers ([exn:fail? (lambda (_) #t)])
              (host-retain-reference owner ref) #f)
            "retain: released and foreign references refuse"))
  (define worker (session-fetch session "worker"))
  (define echo (session-fetch session "echo"))
  (define pending (session-far-send session worker 'work '() #t))
  (define completion (async-channel-get pending-resolvers))
  (define promise-ref (session-send session echo 'echo pending))
  (expect (ref? promise-ref) "resolve: echo returned a pending capability")
  (define outcomes (make-channel))
  (thread (lambda () (channel-put outcomes (session-resolve session promise-ref))))
  (sleep 0)
  (resolver-fulfill! (car completion) (list (cdr completion)))
  (define outcome (channel-get outcomes))
  (expect (and (list? outcome) (ref? (car outcome))) "resolve: promise settlement carries capabilities")
  (expect (equal? "remote alive" (session-send session (car outcome) 'ping))
          "resolve: settled capability remains callable")
  (host-release-reference! m (car outcome))
  (define original-reply (await-vow session pending 'reference-test "original answer"))
  (host-release-reference! m (car original-reply))
  (release-vow! pending)
  (for ([ref (list worker echo promise-ref)]) (host-release-reference! m ref))
  (define-values (weak token)
    (let* ([source (session-spawn session (lambda (bcom) (methods [(ping) "temporary"])))]
           [final-owner (host-retain-reference m source)])
      (host-release-reference! m source)
      (values (make-weak-box final-owner) (ref-id final-owner))))
  ;; A major collection is the costly step: collect only until the wrapper goes.
  (let collect ([rounds 4])
    (collect-garbage)
    (sleep 0)
    (when (and (weak-box-value weak) (> rounds 1)) (collect (sub1 rounds))))
  (drain-host-gc! m)
  (expect (not (weak-box-value weak)) "retain: the last wrapper was collected")
  ;; This probe bypasses the binding's spent-wrapper guard and owns no C retain.
  (expect (with-handlers ([exn:fail? (lambda (_) #t)])
            (host-retain-reference m (make-ref/internal token)) #f)
          "retain: collection retires the final native occurrence")
  (expect (equal? "alive" (session-send session resolved 'ping))
          "retain: collection leaves the control capability and session usable")
  (host-release-reference! m resolved)
  (host-close! foreign)
  (expect (with-handlers ([exn:fail? (lambda (_) #t)])
            (host-retain-reference foreign resolved) #f)
          "retain: closed Host refuses")
  (session-close! session))
(server-close! server)
(thread-wait serving)
(printf "racket test OK: independent retains and object resolution with Session GC off and on\n")
