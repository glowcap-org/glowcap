;; Kind constants + decode for the Racket binding. Executor arms stay
;; in `action.rkt`. Does not require `codec.rkt` (that would cycle
;; through `constants.rkt`); the caller passes `arg<-c`.

(require ffi/unsafe
         "ffi-shared.rkt"
         "ffi-driver.rkt")

(provide HOST-ACTION-DIAL HOST-ACTION-FLUSH HOST-ACTION-NEED-GIFT-ID
         HOST-ACTION-SETTLE HOST-ACTION-FAIL HOST-ACTION-CLOSE
         host-decode-action!)

;; PancakeHostAction.kind — mirrors PANCAKE_HOST_ACTION_* in pancake_driver.h.
(define HOST-ACTION-DIAL 0)
(define HOST-ACTION-FLUSH 1)
(define HOST-ACTION-NEED-GIFT-ID 2)
(define HOST-ACTION-SETTLE 3)
(define HOST-ACTION-FAIL 4)
(define HOST-ACTION-CLOSE 5)

;; Decode a filled PancakeHostAction cstruct into the list form the
;; drain switch matches: `(list 'dial …)`, `(list 'flush …)`, …
;; `arg<-c` is passed by the caller (from codec.rkt) so this module
;; stays require-acyclic with constants.rkt.
(define (host-decode-action! a arg<-c)
  (define kind (PancakeHostAction-kind a))
  (define (view->string ptr len) (bytes->string/utf-8 (bytes<-c ptr len) #\uFFFD))
  (cond
    [(= kind HOST-ACTION-DIAL)
     (list 'dial (PancakeHostAction-ticket a)
           (view->string (PancakeHostAction-transport a) (PancakeHostAction-transport-len a))
           (view->string (PancakeHostAction-designator a) (PancakeHostAction-designator-len a))
           (view->string (PancakeHostAction-direct-addresses-hint a)
                         (PancakeHostAction-direct-addresses-hint-len a)))]
    [(= kind HOST-ACTION-FLUSH)
     (list 'flush (PancakeHostAction-conn a))]
    [(= kind HOST-ACTION-NEED-GIFT-ID)
     (list 'need-gift-id (PancakeHostAction-ticket a))]
    [(= kind HOST-ACTION-SETTLE)
     ;; `arg<-c` copies every byte payload into fresh Racket values, so the
     ;; outcome outlives the popped action's until-next-pop lifetime.
     (list 'settle (PancakeHostAction-ticket a) (arg<-c (PancakeHostAction-value a)))]
    [(= kind HOST-ACTION-FAIL)
     (list 'fail (PancakeHostAction-ticket a)
           (view->string (PancakeHostAction-message a) (PancakeHostAction-message-len a)))]
    [(= kind HOST-ACTION-CLOSE)
     (list 'close (PancakeHostAction-conn a))]
    [else (error 'pancake "unknown host action kind: ~a" kind)]))
