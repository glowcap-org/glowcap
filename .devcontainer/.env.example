# configure.sh generates .env from Git-owned facts. This annotated file shows
# the primary checkout's result and the values an operator may customize. .env
# is gitignored, so the identity remains local to that worktree.
#
# GLOWCAP_WORKTREE is the short designator shared by the linked worktree
# directory and Docker container. configure.sh names the primary checkout main;
# a linked worktree named tree1 produces the container glowcap-tree1 regardless
# of its Git branch name. Lowercase letters and digits only, starting with a
# letter, with at most 12 characters.
GLOWCAP_WORKTREE=main
# Absolute path to the primary checkout's common Git directory. This is shared
# by all of its linked worktrees and keeps their .git pointers valid inside the
# container. From each checkout, obtain the value on the host with:
#   git rev-parse --path-format=absolute --git-common-dir
GLOWCAP_GIT_COMMON_DIR=
# Host ports are local to this worktree. Keep the container-side ports
# canonical; choose a distinct set here for every concurrently running
# worktree. These are the primary checkout's defaults.
GLOWCAP_ROOMS_WEB_HOST_PORT=8000
GLOWCAP_ROOMS_CAPTP_HOST_PORT=9099
GLOWCAP_ROOMS_RELAY_HOST_PORT=9200
GLOWCAP_ROOMS_TRACE_HOST_PORT=9300
GLOWCAP_OCAPNVIZ_HOST_PORT=5173
GLOWCAP_DOCS_HOST_PORT=1990
#
# rooms-net (the fabric shared with the rooms app) has a fixed name and is
# created for you by the devcontainer initializeCommand — nothing to set here.
#
# The default is a managed, isolated bridge. Pass --egress-net to configure.sh
# to use a pre-existing host network that exposes an agent backend instead.
EGRESS_NET=glowcap-main-egress
