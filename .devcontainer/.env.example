# Copy to .env and set your values. .env is gitignored (root .gitignore), so
# per-host infrastructure names stay out of the repo — same convention as
# apps/rooms/web/deploy/.env.example.
#
# rooms-net (the fabric shared with the rooms app) has a fixed name and is
# created for you by the devcontainer initializeCommand — nothing to set here.
#
# EGRESS_NET is this container's one side network: the LLM backend the agents
# reach. Create it once on the Docker host if it does not exist:
#   docker network create llm-backend-net
# Leave it empty in this example file — put the real name only in .env.
EGRESS_NET=
