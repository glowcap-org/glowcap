#!/usr/bin/env python3
"""Serialize finite builds launched through the checkout development front.

Arguments are the command to execute. GLOWCAP_BUILD_LEASE_FILE selects the
lock file and GLOWCAP_BUILD_LEASE_TIMEOUT selects how many seconds contention
may wait. The default is to report the owner immediately and exit 75.

This process holds the lock for exactly as long as the command runs as its
child. The lock descriptor is not inheritable, so nothing the build spawns
can keep the lease alive after the build is gone: a bench server or client
that outlives its parent, or one stuck in kernel exit, holds no lease.
Signals that reach this process are forwarded to the child, and the child's
exit status (128 plus the signal number for a signal death) is this process's.
"""

from __future__ import annotations

import errno
import fcntl
import os
import shlex
import signal
import subprocess
import sys
import time
from typing import NoReturn


NAME = "glowcap-build-lease"


def fail(message: str, status: int) -> NoReturn:
    print(f"{NAME}: {message}", file=sys.stderr)
    raise SystemExit(status)


def parse_timeout(raw: str) -> float:
    try:
        timeout = float(raw)
    except ValueError:
        fail(
            "GLOWCAP_BUILD_LEASE_TIMEOUT must be a non-negative number, "
            f"not {raw!r}",
            2,
        )
    if timeout < 0 or not timeout < float("inf"):
        fail(
            "GLOWCAP_BUILD_LEASE_TIMEOUT must be a finite non-negative number, "
            f"not {raw!r}",
            2,
        )
    return timeout


def try_lock(fd: int) -> bool:
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError as error:
        if error.errno in (errno.EACCES, errno.EAGAIN):
            return False
        raise
    return True


def report_owner(fd: int) -> None:
    print(f"{NAME}: another build owns this worktree", file=sys.stderr)
    owner = os.pread(fd, 64 * 1024, 0).decode(errors="replace").rstrip()
    if owner:
        for line in owner.splitlines():
            print(f"  {line}", file=sys.stderr)


def acquire(fd: int, timeout: float, raw_timeout: str) -> None:
    if try_lock(fd):
        return
    report_owner(fd)
    if timeout == 0:
        fail("inspect that build, then retry when its boundary is free", 75)

    print(f"{NAME}: waiting up to {raw_timeout}s", file=sys.stderr)
    deadline = time.monotonic() + timeout
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            fail(
                "the other build still owns the lease after "
                f"{raw_timeout}s; inspect that build before retrying",
                75,
            )
        time.sleep(min(remaining, 0.05))
        if try_lock(fd):
            return


def write_owner(fd: int, argv: list[str], child_pid: int) -> None:
    owner = (
        f"pid: {os.getpid()}\n"
        f"child: {child_pid}\n"
        f"workdir: {os.getcwd()}\n"
        f"command: {shlex.join(argv)}\n"
    ).encode()
    os.ftruncate(fd, 0)
    with os.fdopen(os.dup(fd), "wb") as owner_file:
        owner_file.write(owner)
        owner_file.flush()


def spawn(argv: list[str]) -> subprocess.Popen[bytes]:
    try:
        return subprocess.Popen(argv)
    except FileNotFoundError:
        fail(f"command not found: {argv[0]}", 127)
    except PermissionError:
        fail(f"command is not executable: {argv[0]}", 126)
    except OSError as error:
        fail(f"cannot execute {argv[0]}: {error}", 126)


def forward_signals(child: subprocess.Popen[bytes]) -> None:
    def forward(signum: int, _frame: object) -> None:
        try:
            child.send_signal(signum)
        except ProcessLookupError:
            pass

    for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(signum, forward)


def main(argv: list[str]) -> int:
    if not argv:
        fail("command required", 2)

    lease_file = os.environ.get(
        "GLOWCAP_BUILD_LEASE_FILE", ".local/glowcap-build.lock"
    )
    raw_timeout = os.environ.get("GLOWCAP_BUILD_LEASE_TIMEOUT", "0")
    timeout = parse_timeout(raw_timeout)
    parent = os.path.dirname(os.path.abspath(lease_file))
    try:
        os.makedirs(parent, exist_ok=True)
        # Non-inheritable (PEP 446): the lock lives and dies with this process.
        fd = os.open(lease_file, os.O_RDWR | os.O_CREAT, 0o600)
        acquire(fd, timeout, raw_timeout)
    except OSError as error:
        fail(f"cannot acquire {lease_file}: {error}", 2)

    child = spawn(argv)
    forward_signals(child)
    try:
        write_owner(fd, argv, child.pid)
    except OSError as error:
        print(f"{NAME}: cannot record the owner: {error}", file=sys.stderr)
    status = child.wait()
    return 128 - status if status < 0 else status


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
