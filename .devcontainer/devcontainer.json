// The Compose container is pancake-${PANCAKE_WORKTREE}; paths in containerEnv
// must match .devcontainer/pins.sh.
//
// Networks: docker-compose.yml declares them; networking.md owns the setup
// steps (EGRESS_NET in the gitignored .devcontainer/.env).
{
  "name": "pancake worktree",
  "dockerComposeFile": "docker-compose.yml",
  "service": "pancake-dev",
  "workspaceFolder": "/workspaces/pancake",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "username": "vscode",
      "userUid": "automatic",
      "userGid": "automatic"
    }
  },
  "remoteUser": "vscode",
  // Compose publishes the rooms ports from each worktree's ignored .env.
  // Do not also ask the editor to forward them: that creates a second host-port
  // allocator and makes two otherwise independent worktrees collide again.
  "containerEnv": {
    "BUN_INSTALL_CACHE_DIR": "/home/vscode/.cache/bun/install",
    "CARGO_HOME": "/home/vscode/.cargo",
    "CARGO_TERM_COLOR": "always",
    "DENO_DIR": "/home/vscode/.cache/deno",
    "npm_config_cache": "/home/vscode/.cache/npm",
    "PIP_CACHE_DIR": "/home/vscode/.cache/pip",
    "PLAYWRIGHT_BROWSERS_PATH": "/usr/local/share/ms-playwright",
    "PLTUSERHOME": "/opt/pancake-racket-userhome",
    "RUSTUP_HOME": "/usr/local/rustup",
    "ZIG_GLOBAL_CACHE_DIR": "/home/vscode/.cache/zig"
  },
  "mounts": [
    "source=pancake-dev-bun-cache,target=/home/vscode/.cache/bun,type=volume",
    "source=pancake-dev-cargo-home,target=/home/vscode/.cargo,type=volume",
    "source=pancake-dev-deno-cache,target=/home/vscode/.cache/deno,type=volume",
    "source=pancake-dev-npm-cache,target=/home/vscode/.cache/npm,type=volume",
    "source=pancake-dev-pip-cache,target=/home/vscode/.cache/pip,type=volume",
    "source=pancake-dev-zig-cache,target=/home/vscode/.cache/zig,type=volume"
  ],
  "initializeCommand": "bash .devcontainer/initialize.sh",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ziglang.vscode-zig",
        "vadimcn.vscode-lldb",
        "rust-lang.rust-analyzer",
        "denoland.vscode-deno",
        "ms-python.python"
      ],
      "settings": {
        "deno.enable": true,
        "zig.path": "zig",
        "zls.enable": true,
        "zls.path": "zls",
        "files.watcherExclude": {
          "**/.cache/**": true,
          "**/.zig-cache/**": true,
          "**/rust-dogfood/target/**": true,
          "**/zig-out/**": true
        }
      }
    }
  }
}
