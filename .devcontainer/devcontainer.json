// The Compose container is glowcap-dev-${GLOWCAP_WORKTREE}; paths in containerEnv
// must match .devcontainer/pins.sh.
//
// Networks: docker-compose.yml declares them; networking.md owns the setup
// steps (EGRESS_NET in the gitignored .devcontainer/.env).
{
  "name": "glowcap worktree",
  "dockerComposeFile": "docker-compose.yml",
  "service": "glowcap-dev",
  "workspaceFolder": "/workspaces/glowcap",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "username": "vscode",
      "userUid": "automatic",
      "userGid": "automatic"
    }
  },
  "remoteUser": "vscode",
  // Compose publishes the service ports from each worktree's ignored .env.
  // Do not also ask the editor to forward them: that creates a second host-port
  // allocator and makes two otherwise independent worktrees collide again.
  "containerEnv": {
    "BUN_INSTALL_CACHE_DIR": "/home/vscode/.cache/glowcap/tool/bun/install",
    "CARGO_HOME": "/home/vscode/.cache/glowcap/cargo",
    "CARGO_TERM_COLOR": "always",
    // Claude Code and the Cursor agent CLI each pick their state directory from
    // an environment variable, so a bind alone does not share their login.
    // Both are pointed at their host bind below. Claude Code otherwise keeps
    // ~/.claude.json outside the bound directory, in the container's writable
    // layer, and every new container starts unrecognized.
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "CURSOR_CONFIG_DIR": "/home/vscode/.cursor",
    "CURSOR_DATA_DIR": "/home/vscode/.cursor",
    "DENO_DIR": "/home/vscode/.cache/glowcap/tool/deno",
    "npm_config_cache": "/home/vscode/.cache/glowcap/tool/npm",
    "PIP_CACHE_DIR": "/home/vscode/.cache/glowcap/tool/pip",
    "PLAYWRIGHT_BROWSERS_PATH": "/usr/local/share/ms-playwright",
    "PLTUSERHOME": "/opt/glowcap-racket-userhome",
    "RUSTUP_HOME": "/usr/local/rustup",
    "UV_CACHE_DIR": "/home/vscode/.cache/glowcap/tool/uv",
    "ZIG_GLOBAL_CACHE_DIR": "/home/vscode/.cache/glowcap/tool/zig"
  },
  "mounts": [
    "source=${localEnv:HOME}/.cache/glowcap,target=/home/vscode/.cache/glowcap,type=bind",
    // Agent tools authenticate and keep user-level harness state for the host
    // user, not one checkout. These scoped binds give every worktree the same
    // login, sessions, configuration, and user resources without mounting all
    // of ~/.config. hooks/initialize.sh creates every source before Docker sees it.
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind",
    "source=${localEnv:HOME}/.codex,target=/home/vscode/.codex,type=bind",
    "source=${localEnv:HOME}/.cursor,target=/home/vscode/.cursor,type=bind",
    "source=${localEnv:HOME}/.config/cursor,target=/home/vscode/.config/cursor,type=bind",
    "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind",
    "source=${localEnv:HOME}/.config/opencode,target=/home/vscode/.config/opencode,type=bind",
    "source=${localEnv:HOME}/.local/share/opencode,target=/home/vscode/.local/share/opencode,type=bind",
    "source=${localEnv:HOME}/.config/agents,target=/home/vscode/.config/agents,type=bind",
    "source=${localEnv:HOME}/.serena,target=/home/vscode/.serena,type=bind"
  ],
  "initializeCommand": "bash .devcontainer/hooks/initialize.sh",
  "postCreateCommand": "bash .devcontainer/hooks/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ziglang.vscode-zig",
        "vadimcn.vscode-lldb",
        "rust-lang.rust-analyzer",
        "denoland.vscode-deno",
        "ms-python.python"
      ],
      "settings": {
        "deno.enable": true,
        "zig.path": "zig",
        "zls.enable": true,
        "files.watcherExclude": {
          "**/.cache/**": true,
          "**/.zig-cache/**": true,
          "**/target/**": true,
          "**/zig-out/**": true
        }
      }
    }
  }
}
