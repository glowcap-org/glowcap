// pancake-zig, paths in containerEnv must match .devcontainer/pins.sh
{
  "name": "pancake-zig",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "username": "vscode",
      "userUid": "automatic",
      "userGid": "automatic"
    }
  },
  "remoteUser": "vscode",
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt=seccomp=unconfined"
  ],
  "containerEnv": {
    "BUN_INSTALL_CACHE_DIR": "/home/vscode/.cache/bun/install",
    "CARGO_HOME": "/home/vscode/.cargo",
    "CARGO_TERM_COLOR": "always",
    "DENO_DIR": "/home/vscode/.cache/deno",
    "npm_config_cache": "/home/vscode/.cache/npm",
    "PIP_CACHE_DIR": "/home/vscode/.cache/pip",
    "PLTUSERHOME": "/opt/pancake-racket-userhome",
    "RUSTUP_HOME": "/usr/local/rustup",
    "ZIG_GLOBAL_CACHE_DIR": "/home/vscode/.cache/zig"
  },
  "mounts": [
    "source=pancake-zig-bun-cache,target=/home/vscode/.cache/bun,type=volume",
    "source=pancake-zig-cargo-home,target=/home/vscode/.cargo,type=volume",
    "source=pancake-zig-deno-cache,target=/home/vscode/.cache/deno,type=volume",
    "source=pancake-zig-npm-cache,target=/home/vscode/.cache/npm,type=volume",
    "source=pancake-zig-pip-cache,target=/home/vscode/.cache/pip,type=volume",
    "source=pancake-zig-zig-cache,target=/home/vscode/.cache/zig,type=volume",
    // Host tool configs the editor does NOT already share, bind-mounted so their
    // login/state comes from the host and survives a rebuild: Claude (skills,
    // memory, login) and the GitHub CLI login. Each resolves per-user through
    // ${localEnv:HOME}, and "initializeCommand" pre-creates the host path so the
    // bind never materializes a root-owned empty. git and SSH are intentionally
    // absent: VS Code / Cursor already copy ~/.gitconfig and forward the host SSH
    // agent. See .devcontainer/README.md ("Sharing host configuration") for the
    // full rationale and the git/SSH/GPG/gh-keyring notes.
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind",
    "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind"
  ],
  "initializeCommand": "mkdir -p ${localEnv:HOME}/.claude ${localEnv:HOME}/.config/gh",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ziglang.vscode-zig",
        "vadimcn.vscode-lldb",
        "rust-lang.rust-analyzer",
        "denoland.vscode-deno",
        "ms-python.python"
      ],
      "settings": {
        "deno.enable": true,
        "zig.path": "zig",
        "zls.enable": true,
        "zls.path": "zls",
        "files.watcherExclude": {
          "**/.cache/**": true,
          "**/.zig-cache/**": true,
          "**/rust-dogfood/target/**": true,
          "**/zig-out/**": true
        }
      }
    }
  }
}
